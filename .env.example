# ==============================================================================
# Peblo TV Mini — Environment Configuration Example (.env.example)
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000

# Security & Authentication Secrets
# WARNING: Generate a cryptographically secure 256-bit key in production:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=peblo_super_secret_jwt_key_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pablo_db
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/pablo_db

# Storage Engine Abstraction
# Options: 'local' (filesystem in development) | 'r2' (Cloudflare R2 in production)
STORAGE_TYPE=local
UPLOAD_DIR=uploads
CATALOGUE_PATH=storage/catalogue.json

# Cloudflare R2 / AWS S3 Settings (Required when STORAGE_TYPE=r2)
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key
# R2_SECRET_ACCESS_KEY=your_r2_secret_key
# R2_BUCKET_NAME=peblo-tv-media
# R2_PUBLIC_DOMAIN=https://media.peblo.tv
