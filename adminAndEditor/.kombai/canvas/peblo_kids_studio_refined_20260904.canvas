      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@500;600;700;800&display=swap');\n\n  :root {\n    --brand: #543488;\n    --brand-strong: #3f2669;\n    --brand-soft: #f2ecfb;\n    --surface: #ffffff;\n    --canvas: #f8f6fc;\n    --ink: #332347;\n    --ink-muted: #766a84;\n    --line: #e6deef;\n    --success: #14866c;\n    --success-soft: #e2f5ee;\n    --warning: #b56b13;\n    --warning-soft: #fff2dc;\n    --danger: #c85353;\n    --danger-soft: #fff0f0;\n    --info: #417bb3;\n    --info-soft: #eaf3fb;\n    --display: 'Fredoka', system-ui, sans-serif;\n    --ui: 'Nunito', 'Quicksand', system-ui, sans-serif;\n    --shadow-float: 0 14px 32px rgba(63, 38, 105, 0.14);\n  }\n\n  .page-wrap,\n  .page-wrap * { box-sizing: border-box; }\n\n  .page-wrap {\n    min-height: 100vh;\n    background: var(--canvas);\n    color: var(--ink);\n    font-family: var(--ui);\n    font-size: 14px;\n    line-height: 1.45;\n    letter-spacing: -0.01em;\n  }\n\n  .app-shell { display: flex; min-height: 100vh; }\n\n  .sidebar {\n    width: 256px;\n    flex: 0 0 256px;\n    min-height: 100vh;\n    padding: 24px 18px 18px;\n    background: var(--surface);\n    border-right: 1px solid var(--line);\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    position: sticky;\n    top: 0;\n    height: 100vh;\n  }\n\n  .brand-lockup { display: flex; align-items: center; gap: 10px; padding: 0 8px; margin-bottom: 32px; }\n  .brand-lockup img { width: 108px; height: auto; display: block; filter: drop-shadow(0 5px 10px rgba(84,52,136,.16)); }\n  .brand-tag { color: var(--brand); border: 1px solid #cdbbe4; background: var(--brand-soft); border-radius: 999px; padding: 4px 8px; font: 800 9px/1 var(--ui); letter-spacing: .07em; text-transform: uppercase; white-space: nowrap; }\n\n  .nav-label { padding: 0 12px; margin: 0 0 8px; color: var(--ink-muted); font: 800 10px/1.2 var(--ui); letter-spacing: .14em; text-transform: uppercase; }\n  .nav-list { display: grid; gap: 5px; }\n  .nav-link,\n  .sidebar-cta,\n  .profile-action,\n  .button,\n  .text-link,\n  .row-action { text-decoration: none; -webkit-tap-highlight-color: transparent; }\n  .nav-link { min-height: 42px; display: flex; align-items: center; gap: 11px; padding: 0 12px; border: 1px solid transparent; border-radius: 10px; color: var(--ink-muted); font: 700 13px/1 var(--ui); }\n  .nav-link.active { background: var(--brand); color: #fff; border-color: var(--brand); box-shadow: 0 8px 18px rgba(84,52,136,.16); }\n  .nav-link:not(.active):hover { color: var(--brand); background: var(--brand-soft); }\n  .nav-link .icon { width: 17px; height: 17px; flex: 0 0 17px; }\n\n  .sidebar-bottom { display: grid; gap: 14px; }\n  .sidebar-divider { height: 1px; background: var(--line); margin: 0 0 2px; }\n  .sidebar-cta { min-height: 42px; display: flex; align-items: center; justify-content: center; gap: 8px; color: var(--brand); background: var(--surface); border: 1px solid #bea9d8; border-radius: 10px; font: 800 12px/1 var(--ui); }\n  .sidebar-cta:hover { background: var(--brand-soft); }\n  .profile-card { padding: 12px; background: #fbf9fe; border: 1px solid var(--line); border-radius: 12px; }\n  .profile-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 10px; }\n  .profile-name { min-width: 0; display: flex; align-items: center; gap: 8px; color: var(--ink); font: 800 12px/1.25 var(--ui); }\n  .profile-name span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n  .role-badge { color: var(--brand); background: var(--brand-soft); border: 1px solid #cdbbe4; border-radius: 999px; padding: 4px 7px; font: 800 9px/1 var(--ui); letter-spacing: .06em; }\n  .profile-action { min-height: 32px; width: 100%; display: flex; align-items: center; justify-content: center; gap: 6px; color: var(--ink-muted); background: var(--surface); border: 1px solid var(--line); border-radius: 8px; font: 800 11px/1 var(--ui); }\n  .profile-action:hover { color: var(--brand); border-color: #cdbbe4; }\n\n  .main { flex: 1; min-width: 0; padding: 32px 42px 48px; }\n  .content { max-width: 1160px; margin: 0 auto; }\n  .topbar { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; margin-bottom: 24px; }\n  .eyebrow { color: var(--brand); font: 800 11px/1.2 var(--ui); letter-spacing: .1em; text-transform: uppercase; margin-bottom: 7px; }\n  .page-title { margin: 0; color: var(--brand-strong); font: 700 31px/1.08 var(--display); letter-spacing: -.03em; }\n  .page-subtitle { margin: 8px 0 0; max-width: 630px; color: var(--ink-muted); font: 600 14px/1.5 var(--ui); }\n  .top-actions { display: flex; align-items: center; gap: 10px; padding-top: 4px; }\n  .button { min-height: 40px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 0 15px; border-radius: 10px; font: 800 12px/1 var(--ui); cursor: pointer; }\n  .button-primary { color: #fff; background: var(--brand); border: 1px solid var(--brand); box-shadow: var(--shadow-float); }\n  .button-primary:hover { background: var(--brand-strong); }\n  .button-secondary { color: var(--brand); background: var(--surface); border: 1px solid #cdbbe4; }\n  .button-secondary:hover { background: var(--brand-soft); }\n  .button-quiet { color: var(--ink-muted); background: var(--surface); border: 1px solid var(--line); }\n  .button-quiet:hover { color: var(--brand); border-color: #cdbbe4; }\n  .button .icon { width: 16px; height: 16px; }\n\n  .story-strip { min-height: 190px; display: grid; grid-template-columns: 1.12fr .88fr; overflow: hidden; background: var(--surface); border: 1px solid var(--line); border-radius: 22px; margin-bottom: 18px; }\n  .story-copy { padding: 25px 28px; display: flex; flex-direction: column; justify-content: space-between; background: var(--brand); color: #fff; position: relative; overflow: hidden; }\n  .story-copy::after { content: ''; position: absolute; width: 180px; height: 180px; right: -72px; top: -92px; border: 1px solid rgba(255,255,255,.18); border-radius: 50%; box-shadow: 0 0 0 16px rgba(255,255,255,.045), 0 0 0 32px rgba(255,255,255,.035); }\n  .story-copy .eyebrow { color: #dbc9ee; position: relative; z-index: 1; }\n  .story-title { margin: 0; max-width: 430px; color: #fff; font: 700 25px/1.12 var(--display); letter-spacing: -.02em; position: relative; z-index: 1; }\n  .story-description { max-width: 500px; color: rgba(255,255,255,.82); font: 600 13px/1.45 var(--ui); margin: 8px 0 0; position: relative; z-index: 1; }\n  .story-meta { display: flex; align-items: center; gap: 12px; margin-top: 14px; position: relative; z-index: 1; }\n  .story-meta-chip { display: inline-flex; align-items: center; gap: 6px; color: #fff; background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.24); border-radius: 999px; padding: 6px 10px; font: 800 11px/1 var(--ui); }\n  .story-meta-chip .icon { width: 14px; height: 14px; color: #eadbfa; }\n  .story-media { position: relative; min-height: 190px; overflow: hidden; background: #e8ddf5; }\n  .story-media img { width: 100%; height: 100%; display: block; object-fit: cover; object-position: center 47%; }\n  .media-caption { position: absolute; left: 16px; right: 16px; bottom: 15px; display: flex; align-items: center; justify-content: space-between; gap: 10px; color: #fff; background: rgba(51,35,71,.78); border: 1px solid rgba(255,255,255,.22); border-radius: 10px; padding: 9px 11px; font: 800 11px/1.2 var(--ui); }\n  .media-caption span:last-child { color: #eadbfa; font-weight: 700; }\n  .comet { position: absolute; top: 24px; left: 22%; width: 8px; height: 8px; border-radius: 50%; background: #fff5c5; box-shadow: 0 0 0 5px rgba(255,245,197,.18), 0 0 18px rgba(255,245,197,.9); opacity: 0; }\n  .comet::after { content: ''; position: absolute; width: 38px; height: 2px; right: 5px; top: 3px; background: rgba(255,245,197,.55); transform: rotate(-18deg); transform-origin: right center; }\n\n  .summary-band { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 16px; overflow: hidden; margin-bottom: 24px; }\n  .summary-item { min-width: 0; padding: 15px 17px; background: var(--surface); display: flex; flex-direction: column; gap: 4px; }\n  .summary-label { color: var(--ink-muted); font: 800 10px/1.2 var(--ui); letter-spacing: .06em; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n  .summary-value { color: var(--brand-strong); font: 700 26px/1 var(--display); font-variant-numeric: tabular-nums; }\n  .summary-note { color: var(--ink-muted); font: 600 11px/1.2 var(--ui); }\n  .summary-item.alert .summary-value { color: var(--danger); }\n  .summary-item.good .summary-value { color: var(--success); }\n\n  .section-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 14px; margin: 0 0 11px; }\n  .section-heading h2 { margin: 0; color: var(--brand-strong); font: 700 19px/1.1 var(--display); letter-spacing: -.02em; }\n  .section-heading p { margin: 4px 0 0; color: var(--ink-muted); font: 600 12px/1.35 var(--ui); }\n  .text-link { display: inline-flex; align-items: center; gap: 5px; color: var(--brand); font: 800 12px/1 var(--ui); white-space: nowrap; }\n  .text-link:hover { color: var(--brand-strong); }\n  .text-link .icon { width: 14px; height: 14px; }\n\n  .readiness-layout { display: grid; grid-template-columns: 1.26fr .74fr; gap: 18px; margin-bottom: 24px; }\n  .panel { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; }\n  .readiness-panel { padding: 22px; }\n  .readiness-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; padding-bottom: 18px; border-bottom: 1px solid var(--line); }\n  .readiness-title { display: flex; align-items: center; gap: 10px; color: var(--brand-strong); font: 700 20px/1.1 var(--display); }\n  .readiness-title .icon { width: 19px; height: 19px; color: var(--danger); }\n  .readiness-copy { margin: 7px 0 0; max-width: 470px; color: var(--ink-muted); font: 600 12px/1.45 var(--ui); }\n  .readiness-count { flex: 0 0 auto; text-align: right; }\n  .readiness-count strong { display: block; color: var(--danger); font: 700 32px/1 var(--display); font-variant-numeric: tabular-nums; }\n  .readiness-count span { color: var(--ink-muted); font: 800 10px/1.2 var(--ui); text-transform: uppercase; letter-spacing: .08em; }\n  .readiness-actions { display: flex; align-items: center; gap: 10px; margin-top: 17px; }\n  .status-line { display: inline-flex; align-items: center; gap: 7px; color: var(--warning); font: 800 11px/1 var(--ui); }\n  .status-dot { width: 7px; height: 7px; border-radius: 50%; background: currentColor; }\n\n  .release-panel { padding: 22px; background: #fbf9fe; }\n  .release-kicker { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 15px; }\n  .release-kicker h3 { margin: 0; color: var(--brand-strong); font: 700 17px/1.1 var(--display); }\n  .release-status { display: inline-flex; align-items: center; gap: 6px; color: var(--success); background: var(--success-soft); border: 1px solid #b9e5d5; border-radius: 999px; padding: 5px 8px; font: 800 10px/1 var(--ui); }\n  .release-time { display: flex; align-items: center; gap: 7px; color: var(--ink-muted); font: 700 12px/1.3 var(--ui); margin-bottom: 16px; }\n  .release-time .icon { width: 14px; height: 14px; color: var(--brand); }\n  .release-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }\n  .release-stat { padding: 10px 8px; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; text-align: center; }\n  .release-stat span { display: block; color: var(--ink-muted); font: 800 9px/1.1 var(--ui); letter-spacing: .06em; text-transform: uppercase; }\n  .release-stat strong { display: block; margin-top: 4px; color: var(--brand-strong); font: 700 18px/1 var(--display); font-variant-numeric: tabular-nums; }\n  .release-link { margin-top: 16px; }\n\n  .eyes-panel { padding: 22px; margin-bottom: 22px; }\n  .eyes-list { display: grid; gap: 10px; }\n  .issue-row { overflow: hidden; border: 1px solid var(--line); border-left-width: 4px; border-radius: 12px; background: var(--surface); }\n  .issue-row.danger { border-left-color: var(--danger); }\n  .issue-row.warning { border-left-color: var(--warning); }\n  .issue-summary { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 14px 15px 14px 13px; background: transparent; border: 0; color: inherit; text-align: left; cursor: pointer; }\n  .issue-main { min-width: 0; display: flex; align-items: center; gap: 11px; }\n  .issue-icon { width: 30px; height: 30px; border-radius: 9px; display: grid; place-items: center; flex: 0 0 30px; }\n  .issue-row.danger .issue-icon { color: var(--danger); background: var(--danger-soft); }\n  .issue-row.warning .issue-icon { color: var(--warning); background: var(--warning-soft); }\n  .issue-copy { min-width: 0; }\n  .issue-title { color: var(--ink); font: 800 13px/1.2 var(--ui); }\n  .issue-meta { display: flex; align-items: center; gap: 7px; margin-top: 4px; color: var(--ink-muted); font: 600 11px/1.25 var(--ui); }\n  .issue-kind { font: 800 9px/1 var(--ui); letter-spacing: .08em; text-transform: uppercase; }\n  .issue-row.danger .issue-kind { color: var(--danger); }\n  .issue-row.warning .issue-kind { color: var(--warning); }\n  .issue-chevron { width: 16px; height: 16px; color: var(--ink-muted); flex: 0 0 16px; }\n  .issue-detail { height: 0; opacity: 0; overflow: hidden; }\n  .issue-detail-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 0 15px 14px 54px; }\n  .issue-detail p { margin: 0; color: var(--ink-muted); font: 600 11px/1.4 var(--ui); }\n  .issue-detail .button { flex: 0 0 auto; min-height: 32px; padding: 0 11px; font-size: 11px; }\n  .issue-row.open .issue-chevron { transform: rotate(180deg); }\n\n  .footer-note { display: flex; align-items: center; justify-content: space-between; gap: 16px; color: var(--ink-muted); font: 600 11px/1.4 var(--ui); }\n  .footer-note strong { color: var(--brand); font-weight: 800; }\n\n  .icon { display: inline-block; width: 16px; height: 16px; stroke-width: 2; }\n  .icon-white { color: #fff; }\n  .icon-brand { color: var(--brand); }\n  .icon-muted { color: var(--ink-muted); }\n  .icon-danger { color: var(--danger); }\n  .icon-warning { color: var(--warning); }\n  .icon-success { color: var(--success); }\n\n  .motion-page, .motion-media, .motion-heading, .motion-metric, .motion-panel, .motion-row { will-change: transform, opacity; }\n  .motion-page { transform-origin: center top; }\n  .button, .nav-link, .sidebar-cta, .profile-action, .text-link, .row-action { transform-origin: center; }\n\n  @media (max-width: 1100px) {\n    .main { padding: 28px 26px 42px; }\n    .sidebar { width: 228px; flex-basis: 228px; }\n    .summary-band { grid-template-columns: repeat(3, 1fr); }\n    .summary-item:last-child { grid-column: span 1; }\n  }\n\n  @media (max-width: 900px) {\n    .app-shell { display: block; }\n    .sidebar { width: 100%; min-height: auto; height: auto; position: relative; padding: 14px 16px; border-right: 0; border-bottom: 1px solid var(--line); }\n    .sidebar-top { display: flex; align-items: center; justify-content: space-between; gap: 16px; }\n    .brand-lockup { margin: 0; padding: 0; }\n    .brand-lockup img { width: 94px; }\n    .brand-tag { font-size: 8px; }\n    .nav-label { display: none; }\n    .nav-list { display: flex; overflow-x: auto; gap: 5px; padding-top: 12px; }\n    .nav-link { flex: 0 0 auto; min-height: 38px; padding: 0 11px; font-size: 12px; }\n    .nav-link .icon { width: 15px; height: 15px; }\n    .sidebar-bottom { display: none; }\n    .main { padding: 24px 18px 36px; }\n    .content { max-width: none; }\n    .topbar { align-items: flex-start; flex-direction: column; gap: 16px; }\n    .top-actions { width: 100%; padding: 0; }\n    .top-actions .button { flex: 1; }\n    .story-strip { grid-template-columns: 1fr; }\n    .story-copy { min-height: 185px; }\n    .story-media { min-height: 180px; }\n    .summary-band { grid-template-columns: repeat(2, 1fr); }\n    .readiness-layout { grid-template-columns: 1fr; }\n    .issue-detail-inner { padding-left: 54px; }\n  }\n\n  @media (max-width: 520px) {\n    .page-title { font-size: 27px; }\n    .page-subtitle { font-size: 13px; }\n    .top-actions { flex-direction: column; }\n    .top-actions .button { width: 100%; }\n    .story-copy { padding: 22px; }\n    .story-title { font-size: 23px; }\n    .summary-band { grid-template-columns: 1fr 1fr; }\n    .summary-item { padding: 13px 12px; }\n    .summary-value { font-size: 23px; }\n    .readiness-panel, .release-panel, .eyes-panel { padding: 18px; }\n    .readiness-top { flex-direction: column; }\n    .readiness-count { text-align: left; }\n    .readiness-actions { align-items: stretch; flex-direction: column; }\n    .release-stats { grid-template-columns: 1fr 1fr 1fr; }\n    .issue-summary { align-items: flex-start; }\n    .issue-detail-inner { align-items: flex-start; flex-direction: column; padding-left: 54px; }\n    .footer-note { align-items: flex-start; flex-direction: column; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .motion-page, .motion-media, .motion-heading, .motion-metric, .motion-panel, .motion-row { will-change: auto; }\n    .nav-link, .sidebar-cta, .profile-action, .button, .text-link, .row-action { transform: none !important; }\n  }\n</style>\n<div class=\"page-wrap\" data-kid=\"1\">\n    <div class=\"app-shell motion-page\" data-kid=\"1-1\">\n        <aside aria-label=\"Studio navigation\" class=\"sidebar\" data-kid=\"1-1-1\">\n            <div class=\"sidebar-top\" data-kid=\"1-1-1-1\">\n                <div 