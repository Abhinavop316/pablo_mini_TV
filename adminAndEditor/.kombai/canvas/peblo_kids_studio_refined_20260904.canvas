  <div class=\"issue-row danger motion-row\" data-kid=\"1-1-2-1-5-2-1\">\n                            <button class=\"issue-summary\" data-dynamic=\"true\" data-expand=\"\" data-kid=\"1-1-2-1-5-2-1-1\" data-name=\"issue row expand button\" data-reason=\"row open state and child element height/opacity reinitialized by script\" type=\"button\">\n                                <span class=\"issue-main\" data-kid=\"1-1-2-1-5-2-1-1-1\">\n                                    <span class=\"issue-icon\" data-kid=\"1-1-2-1-5-2-1-1-1-1\">\n                                        <i aria-hidden=\"true\" class=\"icon icon-danger w-4 h-4\" data-kid=\"1-1-2-1-5-2-1-1-1-1-1\" data-lucide=\"image-up\">\n                                        </i>\n                                    </span>\n                                    <span class=\"issue-copy\" data-kid=\"1-1-2-1-5-2-1-1-1-2\">\n                                        <span class=\"issue-title\" data-kid=\"1-1-2-1-5-2-1-1-1-2-1\">\n                                            The Moon Maze needs a thumbnail\n                                        </span>\n                                        <span class=\"issue-meta\" data-kid=\"1-1-2-1-5-2-1-1-1-2-2\">\n                                            <span class=\"issue-kind\" data-kid=\"1-1-2-1-5-2-1-1-1-2-2-1\">\n                                                Artwork\n                                            </span>\n                                            <span data-kid=\"1-1-2-1-5-2-1-1-1-2-2-2\">\n                                                Astro & Friends · Episode 1\n                                            </span>\n                                        </span>\n                                    </span>\n                                </span>\n                                <i aria-hidden=\"true\" class=\"icon issue-chevron icon-muted w-4 h-4\" data-kid=\"1-1-2-1-5-2-1-1-2\" data-lucide=\"chevron-down\">\n                                </i>\n                            </button>\n                            <div class=\"issue-detail\" data-kid=\"1-1-2-1-5-2-1-2\">\n                                <div class=\"issue-detail-inner\" data-kid=\"1-1-2-1-5-2-1-2-1\">\n                                    <p data-kid=\"1-1-2-1-5-2-1-2-1-1\">\n                                        Upload a 16:9 thumbnail, then the validation check can run again.\n                                    </p>\n                                    <a class=\"button button-secondary interactive-control\" data-kid=\"1-1-2-1-5-2-1-2-1-2\" href=\"#episode-artwork\">\n                                        Open artwork\n                                    </a>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"issue-row warning motion-row\" data-kid=\"1-1-2-1-5-2-2\">\n                            <button class=\"issue-summary\" data-dynamic=\"true\" data-expand=\"\" data-kid=\"1-1-2-1-5-2-2-1\" data-name=\"issue row expand button\" data-reason=\"row open state and child element height/opacity reinitialized by script\" type=\"button\">\n                                <span class=\"issue-main\" data-kid=\"1-1-2-1-5-2-2-1-1\">\n                                    <span class=\"issue-icon\" data-kid=\"1-1-2-1-5-2-2-1-1-1\">\n                                        <i aria-hidden=\"true\" class=\"icon icon-warning w-4 h-4\" data-kid=\"1-1-2-1-5-2-2-1-1-1-1\" data-lucide=\"file-warning\">\n                                        </i>\n                                    </span>\n                                    <span class=\"issue-copy\" data-kid=\"1-1-2-1-5-2-2-1-1-2\">\n                                        <span class=\"issue-title\" data-kid=\"1-1-2-1-5-2-2-1-1-2-1\">\n                                            Curious Comet Club needs a section\n                                        </span>\n                                        <span class=\"issue-meta\" data-kid=\"1-1-2-1-5-2-2-1-1-2-2\">\n                                            <span class=\"issue-kind\" data-kid=\"1-1-2-1-5-2-2-1-1-2-2-1\">\n                                                Metadata\n                                            </span>\n                                            <span data-kid=\"1-1-2-1-5-2-2-1-1-2-2-2\">\n                                                Show details · Draft\n                                            </span>\n                                        </span>\n                                    </span>\n                                </span>\n                                <i aria-hidden=\"true\" class=\"icon issue-chevron icon-muted w-4 h-4\" data-kid=\"1-1-2-1-5-2-2-1-2\" data-lucide=\"chevron-down\">\n                                </i>\n                            </button>\n                            <div class=\"issue-detail\" data-kid=\"1-1-2-1-5-2-2-2\">\n                                <div class=\"issue-detail-inner\" data-kid=\"1-1-2-1-5-2-2-2-1\">\n                                    <p data-kid=\"1-1-2-1-5-2-2-2-1-1\">\n                                        Choose a catalogue section so this show can be included in the next release.\n                                    </p>\n                                    <a class=\"button button-secondary interactive-control\" data-kid=\"1-1-2-1-5-2-2-2-1-2\" href=\"#show-metadata\">\n                                        Edit metadata\n                                    </a>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </section>\n                <div class=\"footer-note\" data-kid=\"1-1-2-1-6\">\n                    <span data-dynamic=\"true\" data-kid=\"1-1-2-1-6-1\" data-name=\"report refresh status\" data-reason=\"text content updated to display time elapsed since last refresh\">\n                        <strong data-kid=\"1-1-2-1-6-1-1\">\n                            Studio check:\n                        </strong>\n                        Last report refreshed 2 minutes ago.\n                    </span>\n                    <span data-kid=\"1-1-2-1-6-2\">\n                        Content stays safe when every blocker has a next action.\n                    </span>\n                </div>\n            </div>\n        </main>\n    </div>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    document.addEventListener('DOMContentLoaded', function () {\n    if (window.lucide) window.lucide.createIcons();\n    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n    var gsapApi = window.gsap;\n\n    function setStaticState() {\n      document.querySelectorAll('.motion-page, .motion-media, .motion-heading, .motion-metric, .motion-panel, .motion-row').forEach(function (el) {\n        el.style.opacity = '1';\n        el.style.transform = 'none';\n      });\n      document.querySelectorAll('.issue-detail').forEach(function (el) {\n        el.style.height = '0px';\n        el.style.opacity = '0';\n      });\n    }\n\n    if (!gsapApi || reduceMotion) {\n      setStaticState();\n    } else {\n      var intro = gsapApi.timeline({ defaults: { ease: 'power2.out' } });\n      intro.from('.motion-page', { autoAlpha: 0, y: 12, duration: 0.32 })\n        .from('.motion-heading', { autoAlpha: 0, y: 10, duration: 0.32 }, '-=0.14')\n        .from('.motion-media', { autoAlpha: 0, y: 12, scale: 0.99, duration: 0.4 }, '-=0.14')\n        .from('.motion-metric', { autoAlpha: 0, y: 10, scale: 0.985, duration: 0.28, stagger: 0.045 }, '-=0.18')\n        .from('.motion-panel', { autoAlpha: 0, y: 12, duration: 0.34, stagger: 0.08 }, '-=0.12')\n        .from('.motion-row', { autoAlpha: 0, y: 8, duration: 0.26, stagger: 0.06 }, '-=0.12');\n      gsapApi.fromTo('.comet', { autoAlpha: 0, x: -20, y: 12 }, { autoAlpha: 1, x: 42, y: -5, duration: 0.62, ease: 'power2.out', delay: 0.35 });\n    }\n\n    function instantOrTween(target, vars) {\n      if (!gsapApi || reduceMotion) {\n        Object.keys(vars).forEach(function (key) {\n          if (key !== 'duration' && key !== 'ease' && key !== 'onComplete') target.style[key] = typeof vars[key] === 'number' ? vars[key] + (key === 'opacity' ? '' : 'px') : vars[key];\n        });\n        if (vars.onComplete) vars.onComplete();\n      } else {\n        gsapApi.to(target, vars);\n      }\n    }\n\n    document.querySelectorAll('.interactive-control, .interactive-link').forEach(function (el) {\n      if (!gsapApi || reduceMotion) return;\n      var enter = gsapApi.to(el, { y: -2, scale: 1.015, duration: 0.18, ease: 'power2.out', paused: true });\n      el.addEventListener('pointerenter', function () { enter.play(); });\n      el.addEventListener('pointerleave', function () { enter.reverse(); });\n    });\n\n    var focusButton = document.querySelector('[data-focus-blockers]');\n    var blockerPanel = document.querySelector('#blockers-panel');\n    if (focusButton && blockerPanel) {\n      focusButton.addEventListener('click', function () {\n        blockerPanel.classList.add('is-focused');\n        blockerPanel.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });\n        if (!reduceMotion && gsapApi) {\n          gsapApi.fromTo(blockerPanel, { y: 5, scale: 0.99 }, { y: 0, scale: 1, duration: 0.36, ease: 'power2.out' });\n        }\n        setTimeout(function () { blockerPanel.classList.remove('is-focused'); }, 1300);\n      });\n    }\n\n    var refreshButton = document.querySelector('[data-refresh]');\n    if (refreshButton) {\n      refreshButton.addEventListener('click', function () {\n        var icon = refreshButton.querySelector('.refresh-icon');\n        var label = refreshButton.querySelector('.refresh-label');\n        if (icon && !reduceMotion && gsapApi) gsapApi.to(icon, { rotation: 360, duration: 0.48, ease: 'power2.out', onComplete: function () { gsapApi.set(icon, { rotation: 0 }); } });\n        if (label) {\n          label.textContent = 'Report refreshed';\n          setTimeout(function () { label.textContent = 'Refresh report'; }, 1600);\n        }\n      });\n    }\n\n    document.querySelectorAll('[data-expand]').forEach(function (toggle) {\n      toggle.addEventListener('click', function () {\n        var row = toggle.closest('.issue-row');\n        var detail = row.querySelector('.issue-detail');\n        var isOpen = row.classList.toggle('open');\n        if (!gsapApi || reduceMotion) {\n          detail.style.height = isOpen ? detail.scrollHeight + 'px' : '0px';\n          detail.style.opacity = isOpen ? '1' : '0';\n          return;\n        }\n        if (isOpen) {\n          gsapApi.set(detail, { height: 0, autoAlpha: 0 });\n          gsapApi.to(detail, { height: detail.scrollHeight, autoAlpha: 1, duration: 0.28, ease: 'power2.out' });\n        } else {\n          gsapApi.to(detail, { height: 0, autoAlpha: 0, duration: 0.22, ease: 'power2.in' });\n        }\n      });\n    });\n  });\n</script>\n",
      "comments": [],
      "created": "2026-09-04T21:48:35.687554+00:00",
      "modified": "2026-09-04T21:49:51.411307+00:00",
      "id": "var_3f9377352a3f",
      "viewportScrollY": 0
    },
    "var_2a6ea52d150c": {
      "type": "variant",
      "label": "PeBlo Studio — Orbit summary dashboard",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@500;600;700;800&display=swap');\n\n  :root {\n    --brand: #543488;\n    --brand-strong: #3f2669;\n    --brand-soft: #f2ecfb;\n    --surface: #ffffff;\n    --canvas: #f8f6fc;\n    --ink: #332347;\n    --ink-muted: #766a84;\n    --line: #e6deef;\n    --success: #14866c;\n    --success-soft: #e2f5ee;\n    --warning: #b56b13;\n    --warning-soft: #fff2dc;\n    --danger: #c85353;\n    --danger-soft: #fff0f0;\n    --info: #417bb3;\n    --info-soft: #eaf3fb;\n    --radius-control: 10px;\n    --radius-card: 16px;\n    --radius-hero: 22px;\n    --shadow-float: 0 16px 34px rgba(63, 38, 105, 0.12);\n  }\n\n  .app-shell {\n    min-height: 100vh;\n    display: flex;\n    background: var(--canvas);\n    color: var(--ink);\n    font-family: 'Nunito', system-ui, sans-serif;\n    line-height: 1.45;\n    letter-spacing: -0.01em;\n  }\n\n  .app-shell h1,\n  .app-shell h2,\n  .app-shell h3,\n  .app-shell h4,\n  .app-shell strong,\n  .app-shell .brand-name,\n  .app-shell .nav-label,\n  .app-shell .metric-value,\n  .app-shell .action-label {\n    font-family: 'Fredoka', system-ui, sans-serif;\n  }\n\n  .icon { width: 18px; height: 18px; flex: 0 0 auto; stroke-width: 2; }\n  .icon--brand { color: var(--brand); }\n  .icon--muted { color: var(--ink-muted); }\n  .icon--white { color: white; }\n  .icon--danger { color: var(--danger); }\n  .icon--warning { color: var(--warning); }\n  .icon--success { color: var(--success); }\n\n  .sidebar {\n    width: 264px;\n    flex: 0 0 264px;\n    min-height: 100vh;\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    padding: 24px 18px 20px;\n    background: var(--surface);\n    border-right: 1px solid var(--line);\n  }\n\n  .brand-lockup {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    padding: 2px 10px 24px;\n    border-bottom: 1px solid var(--line);\n  }\n\n  .brand-lockup img { width: 108px; height: auto; display: block; }\n  .brand-tag {\n    padding: 4px 8px;\n    border: 1px solid #cdbce3;\n    border-radius: 999px;\n    color: var(--brand);\n    background: var(--brand-soft);\n    font-size: 10px;\n    font-weight: 800;\n    letter-spacing: 0.06em;\n    text-transform: uppercase;\n    white-space: nowrap;\n  }\n\n  .nav-wrap { padding: 24px 2px; }\n  .nav-kicker {\n    margin: 0 10px 10px;\n    color: var(--ink-muted);\n    font-size: 10px;\n    font-weight: 800;\n    letter-spacing: 0.11em;\n    text-transform: uppercase;\n  }\n\n  .nav-list { display: flex; flex-direction: column; gap: 5px; }\n  .nav-link {\n    display: flex;\n    align-items: center;\n    gap: 11px;\n    min-height: 44px;\n    padding: 0 12px;\n    border: 1px solid transparent;\n    border-radius: var(--radius-control);\n    color: var(--ink-muted);\n    font-size: 13px;\n    font-weight: 800;\n    text-decoration: none;\n    will-change: transform;\n  }\n  .nav-link .icon { color: currentColor; width: 17px; height: 17px; }\n  .nav-link.is-active {\n    color: white;\n    background: var(--brand);\n    border-color: var(--brand);\n    box-shadow: 0 10px 22px rgba(84, 52, 136, 0.18);\n  }\n\n  .sidebar-bottom { display: flex; flex-direction: column; gap: 14px; }\n  .viewer-link {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    min-height: 42px;\n    padding: 0 12px;\n    border: 1px solid #cdbce3;\n    border-radius: var(--radius-control);\n    color: var(--brand);\n    background: var(--surface);\n    font-size: 12px;\n    font-weight: 800;\n    text-decoration: none;\n    will-change: transform;\n  }\n  .profile {\n    padding: 12px;\n    border: 1px solid var(--line);\n    border-radius: var(--radius-card);\n    background: #fcfbfe;\n  }\n  .profile-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }\n  .profile-id { display: flex; align-items: center; gap: 7px; min-width: 0; color: var(--ink-muted); font-size: 11px; font-weight: 800; }\n  .profile-id span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n  .role-badge {\n    padding: 3px 7px;\n    border-radius: 999px;\n    color: white;\n    background: var(--brand);\n    font-size: 9px;\n    font-weight: 800;\n    letter-spacing: 0.06em;\n  }\n  .signout {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 6px;\n    width: 100%;\n    min-height: 36px;\n    margin-top: 11px;\n    border: 1px solid var(--line);\n    border-radius: 9px;\n    color: var(--ink-muted);\n    background: var(--surface);\n    font: 800 11px 'Nunito', system-ui, sans-serif;\n    will-change: transform;\n  }\n\n  .main-area { min-width: 0; flex: 1; padding: 34px 44px 54px; }\n  .content { max-width: 1180px; margin: 0 auto; }\n  .topbar { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; margin-bottom: 22px; }\n  .eyebrow { color: var(--brand); font-size: 11px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }\n  .page-title { margin: 4px 0 4px; color: var(--ink); font-size: 32px; line-height: 1.05; letter-spacing: -0.03em; }\n  .page-subtitle { margin: 0; color: var(--ink-muted); font-size: 14px; font-weight: 600; }\n  .top-actions { display: flex; align-items: center; gap: 10px; }\n  .action-button {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    min-height: 42px;\n    padding: 0 15px;\n    border: 1px solid var(--line);\n    border-radius: var(--radius-control);\n    color: var(--brand);\n    background: var(--surface);\n    font: 800 12px 'Nunito', system-ui, sans-serif;\n    text-decoration: none;\n    cursor: pointer;\n    will-change: transform;\n  }\n  .action-button--primary { color: white; background: var(--brand); border-color: var(--brand); box-shadow: 0 10px 18px rgba(84, 52, 136, 0.16); }\n  .action-button--quiet { color: var(--ink-muted); }\n\n  .media-strip {\n    position: relative;\n    min-height: 170px;\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) 420px;\n    overflow: hidden;\n    border-radius: var(--radius-hero);\n    background: var(--brand-strong);\n    box-shadow: var(--shadow-float);\n  }\n  .media-copy { position: relative; z-index: 2; padding: 26px 30px; color: white; }\n  .media-kicker { display: inline-flex; align-items: center; gap: 7px; color: #e8daf8; font-size: 11px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }\n  .media-title { max-width: 520px; margin: 10px 0 5px; color: white; font-size: 25px; line-height: 1.12; letter-spacing: -0.025em; }\n  .media-copy p { max-width: 500px; margin: 0; color: #eadff5; font-size: 13px; font-weight: 600; }\n  .media-meta { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }\n  .media-chip { padding: 5px 9px; border: 1px solid rgba(255,255,255,.28); border-radius: 7px; color: white; background: rgba(255,255,255,.09); font-size: 10px; font-weight: 800; }\n  .media-art { position: relative; overflow: hidden; }\n  .media-art::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, var(--brand-strong) 0%, rgba(63,38,105,.2) 46%, rgba(63,38,105,0) 100%); pointer-events: none; }\n  .media-art img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; opacity: .9; }\n  .comet-dot { position: absolute; z-index: 3; top: 44px; left: 42px; width: 8px; height: 8px; border-radius: 999px; background: #fff3c6; box-shadow: 0 0 0 5px rgba(255,243,198,.13), 0 0 16px rgba(255,243,198,.9); will-change: transform, opacity; }\n\n  .metrics-band {\n    display: grid;\n    grid-template-columns: repeat(5, minmax(0, 1fr));\n    margin: 18px 0 24px;\n    border: 1px solid var(--line);\n    border-radius: var(--radius-card);\n    background: var(--surface);\n    overflow: hidden;\n  }\n  .metric-cell { min-width: 0; padding: 15px 18px; border-right: 1px solid var(--line); }\n  .metric-cell:last-child { border-right: 0; }\n  .metric-label { color: var(--ink-muted); font-size: 10px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; }\n  .metric-row { display: flex; align-items: baseline; gap: 8px; margin-top: 5px; }\n  .metric-value { color: var(--ink); font-size: 26px; line-height: 1; font-variant-numeric: tabular-nums; }\n  .metric-note { color: var(--ink-muted); font-size: 11px; font-weight: 700; white-space: nowrap; }\n  .metric-note--danger { color: var(--danger); }\n  .metric-note--success { color: var(--success); }\n\n  .primary-grid { display: grid; grid-template-columns: minmax(0, 1.38fr) minmax(300px, .78fr); gap: 18px; align-items: stretch; }\n  .panel { border: 1px solid var(--line); border-radius: var(--radius-card); background: var(--surface); }\n  .readiness-panel { padding: 22px; scroll-margin-top: 20px; }\n  .panel-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }\n  .panel-title { margin: 0; color: var(--ink); font-size: 19px; line-height: 1.1; }\n  .panel-copy { margin: 6px 0 0; color: var(--ink-muted); font-size: 13px; font-weight: 600; }\n  .link-action { display: inline-flex; align-items: center; gap: 5px; min-height: 36px; padding: 0 11px; border: 1px solid #d3c3e6; border-radius: 9px; color: var(--brand); background: var(--brand-soft); font: 800 11px 'Nunito', system-ui, sans-serif; cursor: pointer; white-space: nowrap; will-change: transform; }\n  .readiness-body { display: grid; grid-template-columns: 126px minmax(0,1fr); gap: 22px; align-items: center; margin-top: 24px; }\n  .status-orbit { position: relative; width: 116px; height: 116px; display: grid; place-items: center; border-radius: 50%; background: conic-gradient(var(--danger) 0deg 78deg, #f2edf7 78deg 360deg); }\n  .status-orbit::after { content: ''; position: absolute; inset: 10px; border-radius: 50%; background: var(--surface); }\n  .status-orbit-content { position: relative; z-index: 1; text-align: center; }\n  .status-orbit-number { display: block; color: var(--danger); font: 700 30px/1 'Fredoka', system-ui, sans-serif; font-variant-numeric: tabular-nums; }\n  .status-orbit-label { display: block; margin-top: 3px; color: var(--ink-muted); font-size: 10px; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; }\n  .status-summary { display: flex; flex-direction: column; gap: 10px; }\n  .state-line { display: flex; align-items: flex-start; gap: 10px; padding: 12px 13px; border-radius: 11px; font-size: 12px; font-weight: 700; }\n  .state-line--danger { color: #934242; background: var(--danger-soft); border: 1px solid #f0cfcf; }\n  .state-line--warning { color: #8d5714; background: var(--warning-soft); border: 1px solid #f1d9aa; }\n  .state-line strong { display: block; margin-bottom: 2px; font-size: 12px; }\n  .state-line span { display: block; color: inherit; opacity: .84; font-family: 'Nunito', system-ui, sans-serif; font-size: 11px; font-weight: 700; }\n\n  .release-panel { padding: 22px; display: flex; flex-direction: column; justify-content: space-between; }\n  .release-label { color: var(--ink-muted); font-size: 10px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }\n  .release-status { display: inline-flex; align-items: center; gap: 6px; margin-top: 14px; color: var(--success); font-size: 12px; font-weight: 800; }\n  .release-status-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--success); }\n  .release-time { margin: 8px 0 18px; color: var(--ink); font: 600 18px/1.1 'Fredoka', system-ui, sans-serif; }\n  .release-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; padding-top: 14px; border-top: 1px solid var(--line); }\n  .release-stat { min-width: 0; }\n  .release-stat-label { display: block; color: var(--ink-muted); font-size: 9px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }\n  .release-stat-value { display: block; margin-top: 4px; color: var(--ink); font: 700 18px/1 'Fredoka', system-ui, sans-serif; font-variant-numeric: tabular-nums; }\n  .release-link { display: inline-flex; align-items: center; gap: 5px; margin-top: 18px; color: var(--brand); font-size: 11px; font-weight: 800; text-decoration: none; width: fit-content; will-change: transform; }\n\n  .lower-grid { display: grid; grid-template-columns: minmax(0, 1.38fr) minmax(300px, .78fr); gap: 18px; margin-top: 18px; }\n  .queue-panel { padding: 22px; }\n  .queue-list { display: flex; flex-direction: column; gap: 9px; margin-top: 16px; }\n  .queue-row { width: 100%; padding: 0; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); text-align: left; cursor: pointer; will-change: transform; }\n  .queue-main { display: grid; grid-template-columns: 10px minmax(0,1fr) auto 18px; gap: 10px; align-items: center; min-height: 62px; padding: 0 13px; }\n  .queue-dot { width: 9px; height: 9px; border-radius: 50%; }\n  .queue-dot--danger { background: var(--danger); }\n  .queue-dot--warning { background: var(--warning); }\n  .queue-title { color: var(--ink); font-size: 13px; font-weight: 800; }\n  .queue-meta { margin-top: 2px; color: var(--ink-muted); font-size: 11px; font-weight: 700; }\n  .queue-state { padding: 4px 7px; border-radius: 6px; font-size: 9px; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; }\n  .queue-state--danger { color: #934242; background: var(--danger-soft); }\n  .queue-state--warning { color: #8d5714; background: var(--warning-soft); }\n  .queue-chevron { color: var(--ink-muted); width: 16px; height: 16px; will-change: transform; }\n  .queue-detail { height: 0; overflow: hidden; opacity: 0; padding: 0 42px 0 35px; color: var(--ink-muted); font-size: 11px; font-weight: 700; }\n  .queue-detail strong { color: var(--ink); }\n  .queue-detail-action { display: inline-flex; align-items: center; gap: 5px; margin-top: 8px; padding: 0; border: 0; color: var(--brand); background: transparent; font: 800 11px 'Nunito', system-ui, sans-serif; cursor: pointer; }\n\n  .note-panel { padding: 22px; }\n  .note-list { display: flex; flex-direction: column; gap: 11px; margin-top: 16px; }\n  .note-item { display: flex; gap: 10px; align-items: flex-start; padding-bottom: 11px; border-bottom: 1px solid var(--line); }\n  .note-item:last-child { padding-bottom: 0; border-bottom: 0; }\n  .note-icon { display: grid; place-items: center; width: 28px; height: 28px; flex: 0 0 28px; border-radius: 8px; background: var(--brand-soft); }\n  .note-item p { margin: 0; color: var(--ink-muted); font-size: 11px; font-weight: 700; }\n  .note-item strong { display: block; margin-bottom: 2px; color: var(--ink); font-size: 12px; }\n  .bottom-caption { margin: 20px 0 0; color: var(--ink-muted); font-size: 11px; font-weight: 700; }\n\n  .motion-page, .motion-media, .motion-heading, .motion-metric, .motion-panel, .motion-row { will-change: transform, opacity; }\n\n  @media (max-width: 1100px) {\n    .sidebar { width: 232px; flex-basis: 232px; }\n    .main-area { padding: 28px 28px 46px; }\n    .media-strip { grid-template-columns: minmax(0, 1fr) 320px; }\n  }\n\n  @media (max-width: 900px) {\n    .app-shell { display: block; }\n    .sidebar { width: 100%; min-height: 0; padding: 12px 14px; border-right: 0; border-bottom: 1px solid var(--line); }\n    .sidebar-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }\n    .brand-lockup { padding: 0; border: 0; }\n    .nav-wrap { padding: 12px 0 0; overflow-x: auto; }\n    .nav-kicker, .sidebar-bottom { display: none; }\n    .nav-list { flex-direction: row; min-width: max-content; }\n    .nav-link { min-height: 38px; padding: 0 10px; font-size: 11px; }\n    .nav-link .icon { width: 15px; height: 15px; }\n    .main-area { padding: 22px 16px 38px; }\n    .topbar { align-items: flex-start; flex-direction: column; gap: 14px; }\n    .top-actions { width: 100%; }\n    .top-actions .action-button { flex: 1; }\n    .media-strip { grid-template-columns: 1fr; min-height: 260px; }\n    .media-art { position: absolute; inset: 0; opacity: .5; }\n    .media-copy { padding: 24px; }\n    .metrics-band { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n    .metric-cell:nth-child(2n) { border-right: 0; }\n    .metric-cell:nth-child(-n+3) { border-bottom: 1px solid var(--line); }\n    .primary-grid, .lower-grid { grid-template-columns: 1fr; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .motion-page, .motion-media, .motion-heading, .motion-metric, .motion-panel, .motion-row, .comet-dot { will-change: auto; }\n    .nav-link, .viewer-link, .signout, .action-button, .link-action, .release-link, .queue-row { transform: none !important; }\n  }\n</style>\n<div class=\"app-shell\" data-kid=\"1\" data-name=\"app shell container\">\n    <aside aria-label=\"Studio navigation\" class=\"sidebar motion-page\" data-kid=\"1-1\" data-name=\"studio sidebar navigation\">\n        <div class=\"sidebar-top\" data-kid=\"1-1-1\" data-name=\"sidebar top section\">\n            <div class=\"brand-lockup\" data-kid=\"1-1-1-1\" data-name=\"brand lockup with logo and tag\">\n                <img alt=\"PeBlo\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logo.png\"/>\n                <span class=\"brand-tag\" data-kid=\"1-1-1-1-2\" data-name=\"studio cms version tag\">\n                    Studio CMS\n                </span>\n            </div>\n            <nav aria-label=\"Primary\" class=\"nav-wrap\" data-kid=\"1-1-1-2\" data-name=\"primary navigation menu\">\n                <p class=\"nav-kicker\" data-kid=\"1-1-1-2-1\" data-name=\"workspace navigation label\">\n                    Workspace\n                </p>\n                <div class=\"nav-list\" data-kid=\"1-1-1-2-2\" data-name=\"navigation link list\">\n                    <a class=\"nav-link is-active\" data-kid=\"1-1-1-2-2-1\" data-name=\"active dashboard navigation link\" href=\"#dashboard\">\n                        <i class=\"icon\" data-kid=\"1-1-1-2-2-1-1\" data-lucide=\"layout-dashboard\" data-name=\"layout dashboard icon\">\n                        </i>\n                        <span class=\"nav-label\" data-kid=\"1-1-1-2-2-1-2\" data-name=\"dashboard link label\">\n                            Dashboard\n                        </span>\n                    </a>\n                    <a class=\"nav-link\" data-kid=\"1-1-1-2-2-2\" data-name=\"shows and series navigation link\" href=\"#shows\">\n                        <i class=\"icon\" data-kid=\"1-1-1-2-2-2-1\" data-lucide=\"film\" data-name=\"film icon\">\n                        </i>\n                        <span class=\"nav-label\" data-kid=\"1-1-1-2-2-2-2\" data-name=\"shows and series link label\">\n                            Shows & Series\n                        </span>\n                    </a>\n                    <a class=\"nav-link\" data-kid=\"1-1-1-2-2-3\" data-name=\"publish console navigation link\" href=\"#publish\">\n                        <i class=\"icon\" data-kid=\"1-1-1-2-2-3-1\" data-lucide=\"upload-cloud\" data-name=\"upload cloud icon\">\n                        </i>\n                        <span class=\"nav-label\" data-kid=\"1-1-1-2-2-3-2\" data-name=\"publish console link label\">\n                            Publish Console\n                        </span>\n                    </a>\n                    <a class=\"nav-link\" data-kid=\"1-1-1-2-2-4\" data-name=\"publish history navigation link\" href=\"#history\">\n                        <i class=\"icon\" data-kid=\"1-1-1-2-2-4-1\" data-lucide=\"history\" data-name=\"history icon\">\n                        </i>\n                        <span class=\"nav-label\" data-kid=\"1-1-1-2-2-4-2\" data-name=\"publish history link label\">\n                            Publish History\n                        </span>\n                    </a>\n                    <a class=\"nav-link\" data-kid=\"1-1-1-2-2-5\" data-name=\"team and editors navigation link\" href=\"#team\">\n                        <i class=\"icon\" data-kid=\"1-1-1-2-2-5-1\" data-lucide=\"users\" data-name=\"users group icon\">\n                        </i>\n                        <span class=\"nav-label\" data-kid=\"1-1-1-2-2-5-2\" data-name=\"team and editors link label\">\n                            Team & Editors\n                        </span>\n                    </a>\n                </div>\n            </nav>\n        </div>\n        <div class=\"sidebar-bottom\" data-kid=\"1-1-2\" data-name=\"sidebar bottom section\">\n            <a class=\"viewer-link\" data-kid=\"1-1-2-1\" data-name=\"open viewer link\" href=\"#viewer\">\n                <i class=\"icon icon--brand\" data-kid=\"1-1-2-1-1\" data-lucide=\"external-link\" data-name=\"external link icon\">\n                </i>\n                Open Viewer\n            </a>\n            <div class=\"profile\" data-kid=\"1-1-2-2\" data-name=\"user profile panel\">\n                <div class=\"profile-top\" data-kid=\"1-1-2-2-1\" data-name=\"profile identity section\">\n                    <div class=\"profile-id\" data-kid=\"1-1-2-2-1-1\" data-name=\"user account identifier\">\n                        <i class=\"icon icon--brand\" data-kid=\"1-1-2-2-1-1-1\" data-lucide=\"user-round\" data-name=\"user round icon\">\n                        </i>\n                        <span data-kid=\"1-1-2-2-1-1-2\" data-name=\"administrator email address\">\n                            admin@peblo.tv\n                        </span>\n                    </div>\n                    <span class=\"role-badge\" data-kid=\"1-1-2-2-1-2\" data-name=\"role badge\">\n                        ADMIN\n                    </span>\n                </div>\n                <button class=\"signout\" data-kid=\"1-1-2-2-2\" data-name=\"sign out button\" type=\"button\">\n                    <i class=\"icon icon--muted\" data-kid=\"1-1-2-2-2-1\" data-lucide=\"log-out\" data-name=\"log out icon\">\n                    </i>\n                    Sign out\n                </button>\n            </div>\n        </div>\n    </aside>\n    <main class=\"main-area\" data-kid=\"1-2\" data-name=\"main dashboard content area\" id=\"dashboard\">\n        <div class=\"content motion-page\" data-kid=\"1-2-1\" data-name=\"dashboard layout wrapper\">\n            <header class=\"topbar motion-heading\" data-kid=\"1-2-1-1\" data-name=\"topbar header section\">\n                <div data-kid=\"1-2-1-1-1\" data-name=\"page welcome message container\">\n                    <div class=\"eyebrow\" data-kid=\"1-2-1-1-1-1\" data-name=\"overview date eyebrow\">\n                        Tuesday, September 3 · Studio overview\n                    </div>\n                    <h1 class=\"page-title\" data-kid=\"1-2-1-1-1-2\" data-name=\"good morning greeting headline\">\n                        Good morning, Maya\n                    </h1>\n                    <p class=\"page-subtitle\" data-kid=\"1-2-1-1-1-3\" data-name=\"dashboard guidance subtitle\">\n                        Keep the catalogue tidy, then send the next learning adventure live.\n                    </p>\n                </div>\n                <div class=\"top-actions\" data-kid=\"1-2-1-1-2\" data-name=\"top actions toolbar\">\n                    <button class=\"action-button action-button--quiet\" data-dynamic=\"true\" data-kid=\"1-2-1-1-2-1\" data-name=\"refresh report button\" data-reason=\"button label text replaced by script after click\" data-refresh=\"\" type=\"button\">\n                        <i class=\"icon icon--muted\" data-dynamic=\"true\" data-kid=\"1-2-1-1-2-1-1\" data-lucide=\"refresh-cw\" data-name=\"refresh cw icon\" data-reason=\"icon rotation animated by script\" data-refresh-icon=\"\">\n                        </i>\n                        <span data-dynamic=\"true\" data-kid=\"1-2-1-1-2-1-2\" data-name=\"refresh report button label\" data-reason=\"text content replaced by script\" data-refresh-label=\"\">\n                            Refresh report\n                        </span>\n                    </button>\n                    <a class=\"action-button action-button--primary\" data-kid=\"1-2-1-1-2-2\" data-name=\"open publish console button\" href=\"#publish\">\n                        <i class=\"icon icon--white\" data-kid=\"1-2-1-1-2-2-1\" data-lucide=\"arrow-up-right\" data-name=\"arrow up right icon\">\n                        </i>\n                        Open publish console\n                    </a>\n                </div>\n            </header>\n            <section aria-label=\"Today's studio check-in\" class=\"media-strip motion-media\" data-kid=\"1-2-1-2\" data-name=\"studio check-in media strip\">\n                <div class=\"media-copy\" data-kid=\"1-2-1-2-1\" data-name=\"media strip text content\">\n                    <div class=\"media-kicker\" data-kid=\"1-2-1-2-1-1\" data-name=\"media strip kicker\">\n                        <i class=\"icon icon--white\" data-kid=\"1-2-1-2-1-1-1\" data-lucide=\"sun\" data-name=\"sun icon\">\n                        </i>\n                        Today's studio check-in\n                    </div>\n                    <h2 class=\"media-title\" data-kid=\"1-2-1-2-1-2\" data-name=\"media strip title headline\">\n                        Two tiny fixes before the next story takes flight.\n                    </h2>\n                    <p data-kid=\"1-2-1-2-1-3\" data-name=\"media strip description text\">\n                        Artwork and section metadata are the only blockers between the catalogue and a clean publish.\n                    </p>\n                    <div class=\"media-meta\" data-kid=\"1-2-1-2-1-4\" data-name=\"media strip meta badges\">\n                        <span class=\"media-chip\" data-kid=\"1-2-1-2-1-4-1\" data-name=\"show ready chip\">\n                            1 show ready\n                        </span>\n                        <span class=\"media-chip\" data-kid=\"1-2-1-2-1-4-2\" data-name=\"blockers chip\">\n                            2 blockers\n                        </span>\n                        <span class=\"media-chip\" data-kid=\"1-2-1-2-1-4-3\" data-name=\"episodes count chip\">\n                            16 episodes in catalogue\n                        </span>\n                    </div>\n                </div>\n                <div class=\"media-art\" data-kid=\"1-2-1-2-2\" data-name=\"media strip artwork container\">\n                    <img alt=\"PeBlo characters exploring the sky in a flying storybook\" data-kid=\"1-2-1-2-2-1\" data-name=\"media strip artwork image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/hero-bg.jpg\"/>\n                    <span aria-hidden=\"true\" class=\"comet-dot\" data-dynamic=\"true\" data-kid=\"1-2-1-2-2-2\" data-name=\"animated comet dot\" data-reason=\"dot path animated by script\">\n                    </span>\n                </div>\n            </section>\n            <section aria-label=\"Catalogue summary\" class=\"metrics-band\" data-kid=\"1-2-1-3\" data-name=\"metrics summary band\">\n                <div class=\"metric-cell motion-metric\" data-kid=\"1-2-1-3-1\" data-name=\"total shows metric cell\">\n                    <div class=\"metric-label\" data-kid=\"1-2-1-3-1-1\" data-name=\"metric label\">\n                        Total shows\n                    </div>\n                    <div class=\"metric-row\" data-kid=\"1-2-1-3-1-2\" data-name=\"metric row container\">\n                        <span class=\"metric-value\" data-kid=\"1-2-1-3-1-2-1\" data-name=\"total shows value\">\n                            2\n                        </span>\n                        <span class=\"metric-note\" data-kid=\"1-2-1-3-1-2-2\" data-name=\"total shows note\">\n                            in studio\n                        </span>\n                    </div>\n                </div>\n                <div class=\"metric-cell motion-metric\" data-kid=\"1-2-1-3-2\" data-name=\"published shows metric cell\">\n                    <div class=\"metric-label\" data-kid=\"1-2-1-3-2-1\" data-name=\"metric label\">\n                        Published\n                    </div>\n                    <div class=\"metric-row\" data-kid=\"1-2-1-3-2-2\" data-name=\"metric row container\">\n                        <span class=\"metric-value\" data-kid=\"1-2-1-3-2-2-1\" data-name=\"published shows value\">\n                            1\n                        </span>\n                        <span class=\"metric-note metric-note--success\" data-kid=\"1-2-1-3-2-2-2\" data-name=\"published shows status note\">\n                            ready\n                        </span>\n                    </div>\n                </div>\n                <div class=\"metric-cell motion-metric\" data-kid=\"1-2-1-3-3\" data-name=\"drafts metric cell\">\n                    <div class=\"metric-label\" data-kid=\"1-2-1-3-3-1\" data-name=\"metric label\">\n                        Drafts\n                    </div>\n                    <div class=\"metric-row\" data-kid=\"1-2-1-3-3-2\" data-name=\"metric row container\">\n                        <span class=\"metric-value\" data-kid=\"1-2-1-3-3-2-1\" data-name=\"drafts value\">\n                            1\n                        </span>\n                        <span class=\"metric-note\" data-kid=\"1-2-1-3-3-2-2\" data-name=\"drafts status note\">\n                            in progress\n                        </span>\n                    </div>\n                </div>\n                <div class=\"metric-cell motion-metric\" data-kid=\"1-2-1-3-4\" data-name=\"episodes metric cell\">\n                    <div class=\"metric-label\" data-kid=\"1-2-1-3-4-1\" data-name=\"metric label\">\n                        Episodes\n                    </div>\n                    <div class=\"metric-row\" data-kid=\"1-2-1-3-4-2\" data-name=\"metric row container\">\n                        <span class=\"metric-value\" data-kid=\"1-2-1-3-4-2-1\" data-name=\"episodes value\">\n                            16\n                        </span>\n                        <span class=\"metric-note\" data-kid=\"1-2-1-3-4-2-2\" data-name=\"episodes status note\">\n                            across shows\n                        </span>\n                    </div>\n                </div>\n                <div class=\"metric-cell motion-metric\" data-kid=\"1-2-1-3-5\" data-name=\"needs attention metric cell\">\n                    <div class=\"metric-label\" data-kid=\"1-2-1-3-5-1\" data-name=\"metric label\">\n                        Needs attention\n                    </div>\n                    <div class=\"metric-row\" data-kid=\"1-2-1-3-5-2\" data-name=\"metric row container\">\n                        <span class=\"metric-value metric-note--danger\" data-kid=\"1-2-1-3-5-2-1\" data-name=\"needs attention value\">\n                            2\n                        </span>\n                        <span class=\"metric-note metric-note--danger\" data-kid=\"1-2-1-3-5-2-2\" data-name=\"needs attention status note\">\n                            blocking\n                        </span>\n                    </div>\n                </div>\n            </section>\n            <section class=\"primary-grid\" data-kid=\"1-2-1-4\" data-name=\"top primary grid panel container\">\n                <article class=\"panel readiness-panel motion-panel\" data-kid=\"1-2-1-4-1\" data-name=\"publishing readiness panel\" id=\"readiness-panel\">\n                    <div class=\"panel-head\" data-kid=\"1-2-1-4-1-1\" data-name=\"panel header section\">\n                        <div data-kid=\"1-2-1-4-1-1-1\" data-name=\"panel title area\">\n                            <h2 class=\"panel-title\" data-kid=\"1-2-1-4-1-1-1-1\" data-name=\"publishing readiness title\">\n                                Publishing readiness\n                            </h2>\n                            <p class=\"panel-copy\" data-kid=\"1-2-1-4-1-1-1-2\" data-name=\"publishing readiness description\">\n                                Review the two things keeping today’s catalogue from going live.\n                            </p>\n                        </div>\n                        <button class=\"link-action\" data-kid=\"1-2-1-4-1-1-2\" data-name=\"review blockers button\" data-review=\"\" type=\"button\">\n                            <i class=\"icon icon--brand\" data-kid=\"1-2-1-4-1-1-2-1\" data-lucide=\"scan-search\" data-name=\"scan search icon\">\n                            </i>\n                            Review blockers\n                        </button>\n                    </div>\n                    <div class=\"readiness-body\" data-kid=\"1-2-1-4-1-2\" data-name=\"readiness details section\">\n                        <div aria-label=\"2 blockers\" class=\"status-orbit\" data-kid=\"1-2-1-4-1-2-1\" data-name=\"blockers count orbit indicator\">\n                            <div class=\"status-orbit-content\" data-kid=\"1-2-1-4-1-2-1-1\" data-name=\"blockers count content\">\n                                <span class=\"status-orbit-number\" data-kid=\"1-2-1-4-1-2-1-1-1\" data-name=\"blockers value number\">\n                                    2\n                                </span>\n                                <span class=\"status-orbit-label\" data-kid=\"1-2-1-4-1-2-1-1-2\" data-name=\"blockers label\">\n                                    blockers\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"status-summary\" data-kid=\"1-2-1-4-1-2-2\" data-name=\"blockers summary list\">\n                            <div class=\"state-line state-line--danger\" data-kid=\"1-2-1-4-1-2-2-1\" data-name=\"thumbnail missing state line\">\n                                <i class=\"icon icon--danger\" data-kid=\"1-2-1-4-1-2-2-1-1\" data-lucide=\"image-off\" data-name=\"image off icon\">\n                                </i>\n                                <div data-kid=\"1-2-1-4-1-2-2-1-2\" data-name=\"thumbnail error details\">\n                                    <strong data-kid=\"1-2-1-4-1-2-2-1-2-1\" data-name=\"thumbnail missing title\">\n                                        Thumbnail missing\n                                    </strong>\n                                    <span data-kid=\"1-2-1-4-1-2-2-1-2-2\" data-name=\"thumbnail missing description\">\n                                        The Moon Maze needs a 16:9 episode image.\n                                    </span>\n                                </div>\n                            </div>\n                            <div class=\"state-line state-line--warning\" data-kid=\"1-2-1-4-1-2-2-2\" data-name=\"metadata missing state line\">\n                                <i class=\"icon icon--warning\" data-kid=\"1-2-1-4-1-2-2-2-1\" data-lucide=\"tag\" data-name=\"tag icon\">\n                                </i>\n                                <div data-kid=\"1-2-1-4-1-2-2-2-2\" data-name=\"metadata error details\">\n                                    <strong data-kid=\"1-2-1-4-1-2-2-2-2-1\" data-name=\"metadata missing title\">\n                                        Section metadata missing\n                                    </strong>\n                                    <span data-kid=\"1-2-1-4-1-2-2-2-2-2\" data-name=\"metadata missing description\">\n                                        Curious Comet Club needs a catalogue section.\n                                    </span>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </article>\n                <article class=\"panel release-panel motion-panel\" data-kid=\"1-2-1-4-2\" data-name=\"last release summary panel\">\n                    <div data-kid=\"1-2-1-4-2-1\" data-name=\"last release info header\">\n                        <div class=\"release-label\" data-kid=\"1-2-1-4-2-1-1\" data-name=\"last release label\">\n                            Last release\n                        </div>\n                        <div class=\"release-status\" data-kid=\"1-2-1-4-2-1-2\" data-name=\"release success status badge\">\n                            <span class=\"release-status-dot\" data-kid=\"1-2-1-4-2-1-2-1\" data-name=\"status dot\">\n                            </span>\n                            Published successfully\n                        </div>\n                        <div class=\"release-time\" data-kid=\"1-2-1-4-2-1-3\" data-name=\"release timestamp\">\n                            September 3, 3:30 PM\n                        </div>\n                    </div>\n                    <div class=\"release-grid\" data-kid=\"1-2-1-4-2-2\" data-name=\"release stats grid\">\n                        <div class=\"release-stat\" data-kid=\"1-2-1-4-2-2-1\" data-name=\"release shows stat\">\n                            <span class=\"release-stat-label\" data-kid=\"1-2-1-4-2-2-1-1\" data-name=\"shows stat label\">\n                                Shows\n                            </span>\n                            <span class=\"release-stat-value\" data-kid=\"1-2-1-4-2-2-1-2\" data-name=\"shows stat value\">\n                                8\n                            </span>\n                        </div>\n                        <div class=\"release-stat\" data-kid=\"1-2-1-4-2-2-2\" data-name=\"release episodes stat\">\n                            <span class=\"release-stat-label\" data-kid=\"1-2-1-4-2-2-2-1\" data-name=\"episodes stat label\">\n                                Episodes\n                            </span>\n                            <span class=\"release-stat-value\" data-kid=\"1-2-1-4-2-2-2-2\" data-name=\"episodes stat value\">\n                                46\n                            </span>\n                        </div>\n                        <div class=\"release-stat\" data-kid=\"1-2-1-4-2-2-3\" data-name=\"release size stat\">\n                            <span class=\"release-stat-label\" data-kid=\"1-2-1-4-2-2-3-1\" data-name=\"size stat label\">\n                                Size\n                            </span>\n                            <span class=\"release-stat-value\" data-kid=\"1-2-1-4-2-2-3-2\" data-name=\"size stat value\">\n                                178 KB\n                            </span>\n                        </div>\n                    </div>\n                    <a class=\"release-link\" data-kid=\"1-2-1-4-2-3\" data-name=\"open release history link\" href=\"#history\">\n                        Open release history\n                        <i class=\"icon icon--brand\" data-kid=\"1-2-1-4-2-3-1\" data-lucide=\"arrow-right\" data-name=\"arrow right icon\">\n                        </i>\n                    </a>\n                </article>\n            </section>\n            <section class=\"lower-grid\" data-kid=\"1-2-1-5\" data-name=\"bottom grid panel container\">\n                <article class=\"panel queue-panel motion-panel\" data-kid=\"1-2-1-5-1\" data-name=\"needs your eyes queue panel\" id=\"blockers\">\n                    <div class=\"panel-head\" data-kid=\"1-2-1-5-1-1\" data-name=\"queue panel header\">\n                        <div data-kid=\"1-2-1-5-1-1-1\" data-name=\"queue panel title area\">\n                            <h2 class=\"panel-title\" data-kid=\"1-2-1-5-1-1-1-1\" data-name=\"needs your eyes title\">\n                                Needs your eyes\n                            </h2>\n                            <p class=\"panel-copy\" data-kid=\"1-2-1-5-1-1-1-2\" data-name=\"needs your eyes description\">\n                                Small fixes, clear next steps.\n                            </p>\n                        </div>\n                        <span class=\"eyebrow\" data-kid=\"1-2-1-5-1-1-2\" data-name=\"queue count eyebrow\">\n                            2 items\n                        </span>\n                    </div>\n                    <div class=\"queue-list\" data-kid=\"1-2-1-5-1-2\" data-name=\"queue item list\">\n                        <button aria-expanded=\"false\" class=\"queue-row motion-row\" data-dynamic=\"true\" data-kid=\"1-2-1-5-1-2-1\" data-name=\"moon maze blocker row\" data-reason=\"detail section expanded by script\" data-row=\"\" type=\"button\">\n                            <span class=\"queue-main\" data-kid=\"1-2-1-5-1-2-1-1\" data-name=\"row main content area\">\n                                <span class=\"queue-dot queue-dot--danger\" data-kid=\"1-2-1-5-1-2-1-1-1\" data-name=\"danger status dot\">\n                                </span>\n                                <span data-kid=\"1-2-1-5-1-2-1-1-2\" data-name=\"row title and metadata\">\n                                    <span class=\"queue-title\" data-kid=\"1-2-1-5-1-2-1-1-2-1\" data-name=\"moon maze title\">\n                                        The Moon Maze\n                                    </span>\n                                    <span class=\"queue-meta\" data-kid=\"1-2-1-5-1-2-1-1-2-2\" data-name=\"moon maze metadata\">\n                                        Astro & Friends · Episode 1 · Artwork\n                                    </span>\n                                </span>\n                                <span class=\"queue-state queue-state--danger\" data-kid=\"1-2-1-5-1-2-1-1-3\" data-name=\"blocked state label\">\n                                    Blocked\n                                </span>\n                                <i class=\"queue-chevron icon icon--muted\" data-dynamic=\"true\" data-kid=\"1-2-1-5-1-2-1-1-4\" data-lucide=\"chevron-down\" data-name=\"chevron icon\" data-reason=\"chevron rotation animated by script\">\n                                </i>\n                            </span>\n                            <span class=\"queue-detail\" data-dynamic=\"true\" data-kid=\"1-2-1-5-1-2-1-2\" data-name=\"row details expandable area\" data-reason=\"height/opacity updated by script\">\n                                <strong data-kid=\"1-2-1-5-1-2-1-2-1\" data-name=\"next action strong text\">\n                                    Next action:\n                                </strong>\n                                Open the episode and upload a 16:9 thumbnail under 200 KB.\n                                <br data-kid=\"1-2-1-5-1-2-1-2-2\" data-name=\"detail action button\"/>\n                                <span class=\"queue-detail-action\" data-kid=\"1-2-1-5-1-2-1-2-3\" data-name=\"open artwork action link\">\n                                    Open episode artwork\n                                    <i class=\"icon icon--brand\" data-kid=\"1-2-1-5-1-2-1-2-3-1\" data-lucide=\"arrow-up-right\" data-name=\"arrow up right icon\">\n                                    </i>\n                                </span>\n                            </span>\n                        </button>\n                        <button aria-expanded=\"false\" class=\"queue-row motion-row\" data-dynamic=\"true\" data-kid=\"1-2-1-5-1-2-2\" data-name=\"comet club blocker row\" data-reason=\"detail section expanded by script\" data-row=\"\" type=\"button\">\n                            <span class=\"queue-main\" data-kid=\"1-2-1-5-1-2-2-1\" data-name=\"row main content area\">\n                                <span class=\"queue-dot queue-dot--warning\" data-kid=\"1-2-1-5-1-2-2-1-1\" data-name=\"warning status dot\">\n                                </span>\n                                <span data-kid=\"1-2-1-5-1-2-2-1-2\" data-name=\"row title and metadata\">\n                                    <span class=\"queue-title\" data-kid=\"1-2-1-5-1-2-2-1-2-1\" data-name=\"comet club title\">\n                                        Curious Comet Club\n                                    </span>\n                                    <span class=\"queue-meta\" data-kid=\"1-2-1-5-1-2-2-1-2-2\" data-name=\"comet club metadata\">\n                                        Show metadata · Catalogue section\n                                    </span>\n                                </span>\n                                <span class=\"queue-state queue-state--warning\" data-kid=\"1-2-1-5-1-2-2-1-3\" data-name=\"needs info state label\">\n                                    Needs info\n                                </span>\n                                <i class=\"queue-chevron icon icon--muted\" data-dynamic=\"true\" data-kid=\"1-2-1-5-1-2-2-1-4\" data-lucide=\"chevron-down\" data-name=\"chevron icon\" data-reason=\"chevron rotation animated by script\">\n                                </i>\n                            </span>\n                            <span class=\"queue-detail\" data-dynamic=\"true\" data-kid=\"1-2-1-5-1-2-2-2\" data-name=\"row details expandable area\" data-reason=\"height/opacity updated by script\">\n                                <strong data-kid=\"1-2-1-5-1-2-2-2-1\" data-name=\"next action strong text\">\n                                    Next action:\n                                </strong>\n                                Add a section such as Kids & Family before publishing.\n                                <br data-kid=\"1-2-1-5-1-2-2-2-2\" data-name=\"detail action button\"/>\n                                <span class=\"queue-detail-action\" data-kid=\"1-2-1-5-1-2-2-2-3\" data-name=\"open show metadata action link\">\n                                    Open show metadata\n                                    <i class=\"icon icon--brand\" data-kid=\"1-2-1-5-1-2-2-2-3-1\" data-lucide=\"arrow-up-right\" data-name=\"arrow up right icon\">\n                                    </i>\n                                </span>\n                            </span>\n                        </button>\n                    </div>\n                </article>\n                <aside class=\"panel note-panel motion-panel\" data-kid=\"1-2-1-5-2\" data-name=\"shortcuts aside panel\">\n                    <h2 class=\"panel-title\" data-kid=\"1-2-1-5-2-1\" data-name=\"shortcuts title\">\n                        Studio shortcuts\n                    </h2>\n                    <p class=\"panel-copy\" data-kid=\"1-2-1-5-2-2\" data-name=\"shortcuts description\">\n                        Useful places for the next five minutes.\n                    </p>\n                    <div class=\"note-list\" data-kid=\"1-2-1-5-2-3\" data-name=\"shortcuts item list\">\n                        <a class=\"note-item\" data-kid=\"1-2-1-5-2-3-1\" data-name=\"shows catalogue shortcut\" href=\"#shows\">\n                            <span class=\"note-icon\" data-kid=\"1-2-1-5-2-3-1-1\" data-name=\"icon container\">\n                                <i class=\"icon icon--brand\" data-kid=\"1-2-1-5-2-3-1-1-1\" data-lucide=\"film\" data-name=\"film icon\">\n                                </i>\n                            </span>\n                            <p data-kid=\"1-2-1-5-2-3-1-2\" data-name=\"shortcut description\">\n                                <strong data-kid=\"1-2-1-5-2-3-1-2-1\" data-name=\"shows catalogue label\">\n                                    Shows catalogue\n                                </strong>\n                                Find a series, season, or episode.\n                            </p>\n                        </a>\n                        <a class=\"note-item\" data-kid=\"1-2-1-5-2-3-2\" data-name=\"validation report shortcut\" href=\"#publish\">\n                            <span class=\"note-icon\" data-kid=\"1-2-1-5-2-3-2-1\" data-name=\"icon container\">\n                                <i class=\"icon icon--brand\" data-kid=\"1-2-1-5-2-3-2-1-1\" data-lucide=\"clipboard-check\" data-name=\"clipboard check icon\">\n                                </i>\n                            </span>\n                            <p data-kid=\"1-2-1-5-2-3-2-2\" data-name=\"shortcut description\">\n                                <strong data-kid=\"1-2-1-5-2-3-2-2-1\" data-name=\"validation report label\">\n                                    Validation report\n                                </strong>\n                                See every blocker in one place.\n                            </p>\n                        </a>\n                        <a class=\"note-item\" data-kid=\"1-2-1-5-2-3-3\" data-name=\"invite editor shortcut\" href=\"#team\">\n                            <span class=\"note-icon\" data-kid=\"1-2-1-5-2-3-3-1\" data-name=\"icon container\">\n                                <i class=\"icon icon--brand\" data-kid=\"1-2-1-5-2-3-3-1-1\" data-lucide=\"user-plus\" data-name=\"user plus icon\">\n                                </i>\n                            </span>\n                            <p data-kid=\"1-2-1-5-2-3-3-2\" data-name=\"shortcut description\">\n                                <strong data-kid=\"1-2-1-5-2-3-3-2-1\" data-name=\"invite editor label\">\n                                    Invite an editor\n                                </strong>\n                                Give a teammate a safe setup link.\n                            </p>\n                        </a>\n                    </div>\n                    <p class=\"bottom-caption\" data-kid=\"1-2-1-5-2-4\" data-name=\"footer caption\">\n                        PeBlo keeps the busy work calm so the stories can stay curious.\n                    </p>\n                </aside>\n            </section>\n        </div>\n    </main>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script>\n    document.addEventListener('DOMContentLoaded', () => {\n    lucide.createIcons();\n    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n    const motionTargets = '.motion-page, .motion-media, .motion-heading, .motion-metric, .motion-panel, .motion-row';\n\n    if (reduceMotion) {\n      gsap.set(motionTargets, { autoAlpha: 1, y: 0, scale: 1 });\n      gsap.set('.comet-dot', { autoAlpha: 0, x: 0, y: 0, scale: 1 });\n    } else {\n      const intro = gsap.timeline({ defaults: { ease: 'power2.out' } });\n      intro\n        .from('.motion-page', { autoAlpha: 0, y: 10, duration: 0.32 })\n        .from('.motion-heading', { autoAlpha: 0, y: 12, duration: 0.34 }, '-=0.16')\n        .from('.motion-media', { autoAlpha: 0, y: 14, scale: 0.985, duration: 0.42 }, '-=0.14')\n        .from('.motion-metric', { autoAlpha: 0, y: 9, duration: 0.28, stagger: 0.045 }, '-=0.16')\n        .from('.motion-panel', { autoAlpha: 0, y: 12, duration: 0.34, stagger: 0.06 }, '-=0.12')\n        .from('.motion-row', { autoAlpha: 0, y: 8, duration: 0.26, stagger: 0.06 }, '-=0.14')\n        .fromTo('.comet-dot', { autoAlpha: 0, scale: 0 }, { autoAlpha: 1, scale: 1, duration: 0.18 }, '-=0.04')\n        .to('.comet-dot', { x: 150, y: -20, scale: 0.72, autoAlpha: 0, duration: 0.68, ease: 'power2.inOut' });\n    }\n\n    document.querySelectorAll('a, button').forEach((element) => {\n      if (element.hasAttribute('disabled')) return;\n      const hover = gsap.to(element, { y: -2, scale: 1.015, duration: 0.18, ease: 'power2.out', paused: true });\n      element.addEventListener('pointerenter', () => { if (!reduceMotion) hover.play(); });\n      element.addEventListener('pointerleave', () => { if (!reduceMotion) hover.reverse(); });\n    });\n\n    const refreshButton = document.querySelector('[data-refresh]');\n    refreshButton?.addEventListener('click', () => {\n      const label = refreshButton.querySelector('[data-refresh-label]');\n      const icon = refreshButton.querySelector('[data-refresh-icon]');\n      if (label) label.textContent = 'Report refreshed';\n      if (!reduceMotion && icon) gsap.to(icon, { rotation: 360, duration: 0.48, ease: 'power2.out' });\n      window.setTimeout(() => { if (label) label.textContent = 'Refresh report'; }, reduceMotion ? 900 : 1300);\n    });\n\n    const reviewButton = document.querySelector('[data-review]');\n    reviewButton?.addEventListener('click', () => {\n      const blockers = document.querySelector('#blockers');\n      blockers?.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });\n      if (!reduceMotion) {\n        gsap.timeline().to('#blockers', { boxShadow: '0 0 0 4px rgba(200,83,83,.16)', duration: 0.18, ease: 'power2.out' }).to('#blockers', { boxShadow: '0 0 0 0 rgba(200,83,83,0)', duration: 0.48, delay: 0.22, ease: 'power2.out' });\n      }\n    });\n\n    document.querySelectorAll('[data-row]').forEach((row) => {\n      row.addEventListener('click', () => {\n        const detail = row.querySelector('.queue-detail');\n        const chevron = row.querySelector('.queue-chevron');\n        const isOpen = row.getAttribute('aria-expanded') === 'true';\n        row.setAttribute('aria-expanded', String(!isOpen));\n        if (!detail) return;\n        if (reduceMotion) {\n          detail.style.height = isOpen ? '0px' : 'auto';\n          detail.style.opacity = isOpen ? '0' : '1';\n          if (chevron) chevron.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';\n          return;\n        }\n        if (isOpen) {\n          gsap.to(detail, { height: 0, autoAlpha: 0, duration: 0.22, ease: 'power2.inOut' });\n          if (chevron) gsap.to(chevron, { rotation: 0, duration: 0.22, ease: 'power2.out' });\n        } else {\n          gsap.fromTo(detail, { height: 0, autoAlpha: 0 }, { height: 'auto', autoAlpha: 1, duration: 0.28, ease: 'power2.out' });\n          if (chevron) gsap.to(chevron, { rotation: 180, duration: 0.22, ease: 'power2.out' });\n        }\n      });\n    });\n  });\n</script>\n",
      "comments": [],
      "created": "2026-09-04T21:48:36.155546+00:00",
      "modified": "2026-09-04T21:49:55.381852+00:00",
      "id": "var_2a6ea52d150c"
    },
    "var_41a1a4eac51f": {
      "type": "variant",
      "label": "PeBlo Studio — Editorial desk dashboard",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3080,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@500;600;700;800&display=swap');\n\n  :root {\n    --brand: #543488;\n    --brand-strong: #3f2669;\n    --brand-soft: #f2ecfb;\n    --surface: #ffffff;\n    --canvas: #f8f6fc;\n    --ink: #332347;\n    --ink-muted: #766a84;\n    --line: #e6deef;\n    --success: #14866c;\n    --success-soft: #e2f5ee;\n    --warning: #b56b13;\n    --warning-soft: #fff2dc;\n    --danger: #c85353;\n    --danger-soft: #fff0f0;\n    --info: #417bb3;\n    --info-soft: #eaf3fb;\n    --shadow-float: 0 14px 34px rgba(63, 38, 105, 0.13);\n    --radius-control: 10px;\n    --radius-card: 16px;\n    --radius-media: 22px;\n  }\n\n  * { box-sizing: border-box; }\n  body {\n    margin: 0;\n    min-width: 320px;\n    background: var(--canvas);\n    color: var(--ink);\n    font-family: 'Nunito', 'Quicksand', system-ui, sans-serif;\n    -webkit-font-smoothing: antialiased;\n  }\n  button, a { font: inherit; }\n  button { cursor: pointer; }\n  a { color: inherit; text-decoration: none; }\n  .app-shell { min-height: 100vh; display: flex; }\n\n  .sidebar {\n    width: 248px;\n    flex: 0 0 248px;\n    min-height: 100vh;\n    padding: 24px 16px 18px;\n    background: var(--surface);\n    border-right: 1px solid var(--line);\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    position: sticky;\n    top: 0;\n    z-index: 10;\n  }\n  .brand-link { display: inline-flex; align-items: center; gap: 10px; padding: 4px 8px 16px; }\n  .brand-logo { width: 108px; height: auto; display: block; }\n  .brand-badge {\n    display: inline-flex;\n    align-items: center;\n    height: 24px;\n    padding: 0 9px;\n    border: 1px solid var(--brand);\n    border-radius: 999px;\n    color: var(--brand);\n    font-size: 10px;\n    font-weight: 800;\n    letter-spacing: .05em;\n  }\n  .nav-heading { margin: 18px 12px 8px; color: var(--ink-muted); font-size: 10px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }\n  .nav-list { display: grid; gap: 4px; }\n  .nav-link {\n    min-height: 42px;\n    display: flex;\n    align-items: center;\n    gap: 11px;\n    padding: 0 12px;\n    border: 1px solid transparent;\n    border-radius: var(--radius-control);\n    color: var(--ink-muted);\n    font-size: 13px;\n    font-weight: 800;\n  }\n  .nav-link.active {\n    background: var(--brand);\n    color: #fff;\n    box-shadow: var(--shadow-float);\n  }\n  .nav-link:not(.active):hover { background: var(--brand-soft); color: var(--brand); }\n  .sidebar-bottom { display: grid; gap: 12px; padding-top: 18px; border-top: 1px solid var(--line); }\n  .viewer-link {\n    min-height: 42px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    border: 1px solid var(--brand);\n    border-radius: var(--radius-control);\n    color: var(--brand);\n    font-size: 12px;\n    font-weight: 800;\n  }\n  .viewer-link:hover { background: var(--brand-soft); }\n  .profile {\n    padding: 12px;\n    border: 1px solid var(--line);\n    border-radius: var(--radius-card);\n    background: #fcfbfe;\n  }\n  .profile-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }\n  .profile-person { min-width: 0; display: flex; align-items: center; gap: 8px; color: var(--brand); }\n  .profile-email { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 11px; font-weight: 800; }\n  .role-badge { padding: 4px 7px; border-radius: 999px; background: var(--brand); color: #fff; font-size: 9px; font-weight: 800; letter-spacing: .05em; }\n  .sign-out { width: 100%; min-height: 34px; margin-top: 10px; border: 1px solid var(--line); border-radius: var(--radius-control); background: var(--surface); color: var(--ink-muted); font-size: 11px; font-weight: 800; }\n  .sign-out:hover { border-color: var(--brand); color: var(--brand); }\n\n  .main { flex: 1; min-width: 0; padding: 34px 42px 56px; }\n  .main-inner { width: min(1180px, 100%); margin: 0 auto; }\n  .page-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 24px; }\n  .eyebrow { margin: 0 0 7px; color: var(--brand); font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }\n  h1, h2, h3, p { margin: 0; }\n  h1, h2, h3 { font-family: 'Fredoka', system-ui, sans-serif; font-weight: 600; letter-spacing: -.02em; }\n  h1 { font-size: clamp(27px, 3vw, 38px); color: var(--ink); line-height: 1.05; }\n  h2 { font-size: 20px; line-height: 1.1; }\n  h3 { font-size: 16px; line-height: 1.15; }\n  .header-copy { max-width: 670px; }\n  .header-copy p { margin-top: 8px; color: var(--ink-muted); font-size: 14px; font-weight: 600; }\n  .header-actions { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; justify-content: flex-end; }\n  .button {\n    min-height: 40px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    padding: 0 14px;\n    border-radius: var(--radius-control);\n    border: 1px solid transparent;\n    font-size: 12px;\n    font-weight: 800;\n  }\n  .button-primary { background: var(--brand); color: #fff; box-shadow: var(--shadow-float); }\n  .button-secondary { background: var(--surface); border-color: var(--line); color: var(--brand); }\n  .button-secondary:hover { border-color: var(--brand); background: var(--brand-soft); }\n\n  .media-strip {\n    min-height: 196px;\n    position: relative;\n    display: grid;\n    grid-template-columns: 1.15fr .85fr;\n    gap: 18px;\n    align-items: stretch;\n    overflow: hidden;\n    margin-bottom: 18px;\n    padding: 24px 26px;\n    border-radius: var(--radius-media);\n    background: var(--brand-soft);\n    border: 1px solid #ded2ef;\n  }\n  .media-copy { position: relative; z-index: 2; display: flex; flex-direction: column; justify-content: center; max-width: 520px; }\n  .media-kicker { margin-bottom: 8px; color: var(--brand); font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }\n  .media-copy h2 { max-width: 480px; font-size: 27px; color: var(--brand-strong); }\n  .media-copy p { max-width: 470px; margin-top: 9px; color: #695b78; font-size: 13px; line-height: 1.5; font-weight: 700; }\n  .media-tag { display: inline-flex; align-items: center; gap: 6px; width: fit-content; margin-top: 14px; padding: 7px 10px; border-radius: var(--radius-control); background: rgba(255,255,255,.75); color: var(--brand); font-size: 11px; font-weight: 800; }\n  .media-art { position: relative; min-height: 146px; overflow: hidden; border-radius: 16px; border: 1px solid rgba(84,52,136,.16); background: var(--surface); }\n  .media-art img { width: 100%; height: 100%; display: block; object-fit: cover; object-position: center; }\n  .media-art::after { content: ''; position: absolute; inset: 0; background: rgba(63,38,105,.08); pointer-events: none; }\n  .comet { position: absolute; z-index: 3; width: 9px; height: 9px; left: 12%; top: 24px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 5px rgba(255,255,255,.32); opacity: 0; }\n\n  .metric-band { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 9px; margin-bottom: 24px; }\n  .metric {\n    min-width: 0;\n    padding: 14px 15px;\n    border: 1px solid var(--line);\n    border-radius: var(--radius-card);\n    background: var(--surface);\n  }\n  .metric-label { display: flex; align-items: center; gap: 7px; color: var(--ink-muted); font-size: 10px; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; }\n  .metric-value { margin-top: 6px; color: var(--ink); font-family: 'Fredoka', system-ui, sans-serif; font-size: 25px; font-weight: 600; font-variant-numeric: tabular-nums; line-height: 1; }\n  .metric-note { margin-top: 5px; color: var(--ink-muted); font-size: 10px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n  .metric-danger { border-color: #efcaca; background: var(--danger-soft); }\n  .metric-danger .metric-label, .metric-danger .metric-value { color: var(--danger); }\n\n  .core-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(300px, .75fr); gap: 18px; align-items: start; }\n  .panel { border: 1px solid var(--line); border-radius: var(--radius-card); background: var(--surface); }\n  .panel-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 14px; padding: 20px 20px 14px; }\n  .panel-header p { margin-top: 5px; color: var(--ink-muted); font-size: 12px; line-height: 1.45; font-weight: 600; }\n  .panel-link { display: inline-flex; align-items: center; gap: 5px; color: var(--brand); font-size: 11px; font-weight: 800; white-space: nowrap; }\n  .panel-link:hover { color: var(--brand-strong); }\n\n  .queue-panel { overflow: hidden; }\n  .queue-intro { padding: 18px 20px 14px; border-bottom: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; gap: 16px; }\n  .queue-intro p { margin-top: 5px; color: var(--ink-muted); font-size: 12px; font-weight: 600; }\n  .queue-count { display: inline-flex; align-items: center; gap: 6px; padding: 6px 9px; border-radius: 999px; background: var(--danger-soft); color: var(--danger); font-size: 10px; font-weight: 800; white-space: nowrap; }\n  .motion-row { border-bottom: 1px solid var(--line); }\n  .motion-row:last-child { border-bottom: 0; }\n  .row-trigger { width: 100%; display: grid; grid-template-columns: 34px minmax(0, 1fr) auto; align-items: center; gap: 12px; padding: 15px 20px; border: 0; background: transparent; text-align: left; color: var(--ink); }\n  .row-trigger:hover { background: #fcfbfe; }\n  .issue-icon { width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; border-radius: 10px; }\n  .issue-icon.danger { color: var(--danger); background: var(--danger-soft); }\n  .issue-icon.warning { color: var(--warning); background: var(--warning-soft); }\n  .row-copy { min-width: 0; }\n  .row-title { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 13px; font-weight: 800; }\n  .row-meta { margin-top: 3px; color: var(--ink-muted); font-size: 11px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n  .row-state { padding: 4px 7px; border-radius: 999px; font-size: 9px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; }\n  .row-state.danger { background: var(--danger-soft); color: var(--danger); }\n  .row-state.warning { background: var(--warning-soft); color: var(--warning); }\n  .row-chevron { color: var(--ink-muted); }\n  .row-detail { height: 0; overflow: hidden; opacity: 0; }\n  .row-detail-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 0 20px 15px 66px; }\n  .row-detail p { max-width: 520px; color: var(--ink-muted); font-size: 11px; line-height: 1.45; font-weight: 600; }\n  .row-action { flex: 0 0 auto; min-height: 32px; display: inline-flex; align-items: center; gap: 6px; padding: 0 10px; border: 1px solid var(--line); border-radius: var(--radius-control); background: var(--surface); color: var(--brand); font-size: 11px; font-weight: 800; }\n  .row-action:hover { border-color: var(--brand); background: var(--brand-soft); }\n\n  .side-stack { display: grid; gap: 18px; }\n  .readiness { overflow: hidden; }\n  .readiness-status { display: inline-flex; align-items: center; gap: 6px; padding: 5px 8px; border-radius: 999px; background: var(--danger-soft); color: var(--danger); font-size: 10px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; }\n  .readiness-status .dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }\n  .readiness-body { padding: 0 20px 20px; }\n  .readiness-lead { color: var(--ink); font-family: 'Fredoka', system-ui, sans-serif; font-size: 22px; line-height: 1.12; }\n  .readiness-copy { margin-top: 8px; color: var(--ink-muted); font-size: 12px; line-height: 1.5; font-weight: 600; }\n  .progress-wrap { margin: 16px 0 15px; }\n  .progress-label { display: flex; justify-content: space-between; gap: 8px; color: var(--ink-muted); font-size: 10px; font-weight: 800; }\n  .progress-track { height: 8px; margin-top: 7px; overflow: hidden; border-radius: 999px; background: var(--brand-soft); }\n  .progress-bar { width: 75%; height: 100%; border-radius: inherit; background: var(--brand); }\n  .release { padding: 20px; }\n  .release-kicker { display: flex; align-items: center; justify-content: space-between; gap: 10px; color: var(--ink-muted); font-size: 10px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }\n  .release-status { color: var(--success); }\n  .release-title { margin-top: 12px; color: var(--ink); font-family: 'Fredoka', system-ui, sans-serif; font-size: 20px; }\n  .release-meta { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 14px; }\n  .release-stat { padding: 10px; border-radius: var(--radius-control); background: #fcfbfe; border: 1px solid var(--line); }\n  .release-stat span { display: block; color: var(--ink-muted); font-size: 9px; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; }\n  .release-stat strong { display: block; margin-top: 4px; color: var(--ink); font-size: 15px; font-variant-numeric: tabular-nums; }\n  .release-link { display: inline-flex; align-items: center; gap: 5px; margin-top: 14px; color: var(--brand); font-size: 11px; font-weight: 800; }\n\n  .focus-ring { border-color: var(--danger); box-shadow: 0 0 0 4px rgba(200,83,83,.14); }\n  .screen-reader-note { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }\n\n  @media (max-width: 1100px) {\n    .sidebar { width: 220px; flex-basis: 220px; }\n    .main { padding-inline: 26px; }\n    .media-strip { grid-template-columns: 1fr .8fr; }\n  }\n  @media (max-width: 900px) {\n    .app-shell { display: block; }\n    .sidebar { width: 100%; min-height: auto; padding: 14px 16px 12px; position: relative; border-right: 0; border-bottom: 1px solid var(--line); }\n    .sidebar-top { display: flex; align-items: center; gap: 18px; overflow: hidden; }\n    .brand-link { padding: 0; flex: 0 0 auto; }\n    .brand-logo { width: 88px; }\n    .nav-heading, .sidebar-bottom { display: none; }\n    .nav-list { display: flex; gap: 5px; overflow-x: auto; padding: 4px 0; }\n    .nav-link { min-height: 36px; flex: 0 0 auto; padding: 0 10px; font-size: 11px; }\n    .nav-link svg { width: 15px; height: 15px; }\n    .main { padding: 24px 16px 40px; }\n    .page-header { align-items: flex-start; flex-direction: column; gap: 16px; }\n    .header-actions { width: 100%; justify-content: flex-start; }\n    .media-strip { grid-template-columns: 1fr; padding: 20px; }\n    .media-art { min-height: 150px; }\n    .metric-band { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n    .core-grid { grid-template-columns: 1fr; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    .motion-page, .motion-media, .motion-heading, .motion-metric, .motion-panel, .motion-row, .comet { animation: none !important; transition: none !important; }\n    .button, .nav-link, .viewer-link, .row-trigger, .row-action, .panel-link, .release-link { transition: none !important; }\n  }\n</style>\n<div class=\"app-shell\" data-kid=\"1\">\n    <aside class=\"sidebar\" data-kid=\"1-1\">\n        <div class=\"sidebar-top\" data-kid=\"1-1-1\">\n            <div data-kid=\"1-1-1-1\">\n                <a aria-label=\"PeBlo Studio dashboard\" class=\"brand-link\" data-kid=\"1-1-1-1-1\" href=\"#dashboard\">\n                    <img alt=\"PeBlo\" class=\"brand-logo\" data-kid=\"1-1-1-1-1-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/logo.png\"/>\n                    <span class=\"brand-badge\" data-kid=\"1-1-1-1-1-2\">\n                        STUDIO CMS\n                    </span>\n                </a>\n                <div class=\"nav-heading\" data-kid=\"1-1-1-1-2\">\n                    Workspace\n                </div>\n                <nav aria-label=\"Primary navigation\" class=\"nav-list\" data-kid=\"1-1-1-1-3\">\n                    <a class=\"nav-link active\" data-kid=\"1-1-1-1-3-1\" href=\"#dashboard\">\n                        <i aria-hidden=\"true\" data-kid=\"1-1-1-1-3-1-1\" data-lucide=\"layout-dashboard\">\n                        </i>\n                        <span data-kid=\"1-1-1-1-3-1-2\">\n                            Dashboard\n                        </span>\n                    </a>\n                    <a class=\"nav-link\" data-kid=\"1-1-1-1-3-2\" href=\"#shows\">\n                        <i aria-hidden=\"true\" data-kid=\"1-1-1-1-3-2-1\" data-lucide=\"film\">\n                        </i>\n                        <span data-kid=\"1-1-1-1-3-2-2\">\n                            Shows & Series\n                        </span>\n                    </a>\n                    <a class=\"nav-link\" data-kid=\"1-1-1-1-3-3\" href=\"#publish\">\n                        <i aria-hidden=\"true\" data-kid=\"1-1-1-1-3-3-1\" data-lucide=\"upload-cloud\">\n                        </i>\n                        <span data-kid=\"1-1-1-1-3-3-2\">\n                            Publish Console\n                        </span>\n                    </a>\n                    <a class=\"nav-link\" data-kid=\"1-1-1-1-3-4\" href=\"#history\">\n                        <i aria-hidden=\"true\" data-kid=\"1-1-1-1-3-4-1\" data-lucide=\"history\">\n                        </i>\n                        <span data-kid=\"1-1-1-1-3-4-2\">\n                            Publish History\n                        </span>\n                    </a>\n                    <a class=\"nav-link\" data-kid=\"1-1-1-1-3-5\" href=\"#team\">\n                        <i aria-hidden=\"true\" data-kid=\"1-1-1-1-3-5-1\" data-lucide=\"users\">\n                        </i>\n                        <span data-kid=\"1-1-1-1-3-5-2\">\n                            Team & Editors\n                        </span>\n                    </a>\n                </nav>\n            </div>\n        </div>\n        <div class=\"sidebar-bottom\" data-kid=\"1-1-2\">\n            <a class=\"viewer-link\" data-kid=\"1-1-2-1\" href=\"#viewer\">\n                <i aria-hidden=\"true\" data-kid=\"1-1-2-1-1\" data-lucide=\"external-link\">\n                </i>\n                <span data-kid=\"1-1-2-1-2\">\n                    Open Viewer\n                </span>\n            </a>\n            <div class=\"profile\" data-kid=\"1-1-2-2\">\n                <div class=\"profile-top\" data-kid=\"1-1-2-2-1\">\n                    <div class=\"profile-person\" data-kid=\"1-1-2-2-1-1\">\n                        <i aria-hidden=\"true\" data-kid=\"1-1-2-2-1-1-1\" data-lucide=\"user-round\">\n                        </i>\n                        <span class=\"profile-email\" data-kid=\"1-1-2-2-1-1-2\">\n                            admin@peblo.tv\n                        </span>\n                    </div>\n                    <span class=\"role-badge\" data-kid=\"1-1-2-2-1-2\">\n                        ADMIN\n                    </span>\n                </div>\n                <button class=\"sign-out\" data-kid=\"1-1-2-2-2\" type=\"button\">\n                    <i aria-hidden=\"true\" data-kid=\"1-1-2-2-2-1\" data-lucide=\"log-out\">\n                    </i>\n                    Sign out\n                </button>\n            </div>\n        </div>\n    </aside>\n    <main class=\"main motion-page\" data-kid=\"1-2\" id=\"dashboard\">\n        <div class=\"main-inner\" data-kid=\"1-2-1\">\n            <header class=\"page-header motion-heading\" data-kid=\"1-2-1-1\">\n                <div class=\"header-copy\" data-kid=\"1-2-1-1-1\">\n                    <p class=\"eyebrow\" data-kid=\"1-2-1-1-1-1\" data-name=\"eyebrow greeting text\">\n                        Studio workspace · Monday, 4 September\n                    </p>\n                    <h1 data-kid=\"1-2-1-1-1-2\">\n                        Good morning, Maya\n                    </h1>\n                    <p data-kid=\"1-2-1-1-1-3\">\n                        Two small fixes will make today’s catalogue ready for the viewer.\n                    </p>\n                </div>\n                <div class=\"header-actions\" data-kid=\"1-2-1-1-2\">\n                    <button class=\"button button-secondary\" data-kid=\"1-2-1-1-2-1\" id=\"refreshReport\" type=\"button\">\n                        <i aria-hidden=\"true\" class=\"refresh-icon\" data-kid=\"1-2-1-1-2-1-1\" data-lucide=\"refresh-cw\">\n                        </i>\n                        <span class=\"refresh-label\" data-dynamic=\"true\" data-kid=\"1-2-1-1-2-1-2\" data-name=\"refresh report label\" data-reason=\"text replaced by script on click\">\n                            Refresh report\n                        </span>\n                    </button>\n                    <a class=\"button button-primary\" data-kid=\"1-2-1-1-2-2\" href=\"#needs-eyes\" id=\"reviewBlockers\">\n                        <i aria-hidden=\"true\" data-kid=\"1-2-1-1-2-2-1\" data-lucide=\"list-checks\">\n                        </i>\n                        <span data-kid=\"1-2-1-1-2-2-2\">\n                            Review blockers\n                        </span>\n                    </a>\n                </div>\n            </header>\n            <section aria-label=\"Today's studio check-in\" class=\"media-strip motion-media\" data-kid=\"1-2-1-2\">\n                <div class=\"media-copy\" data-kid=\"1-2-1-2-1\">\n                    <p class=\"media-kicker\" data-kid=\"1-2-1-2-1-1\">\n                        Today’s studio check-in\n                    </p>\n                    <h2 data-kid=\"1-2-1-2-1-2\">\n                        Make room for one more curious question.\n                    </h2>\n                    <p data-kid=\"1-2-1-2-1-3\">\n                        Astro & Friends is ready to shine. Finish the missing thumbnail and one section label before the next publish.\n                    </p>\n                    <span class=\"media-tag\" data-kid=\"1-2-1-2-1-4\">\n                        <i aria-hidden=\"true\" data-kid=\"1-2-1-2-1-4-1\" data-lucide=\"play-circle\">\n                        </i>\n                        8 shows · 46 episodes in the viewer\n                    </span>\n                </div>\n                <div class=\"media-art\" data-kid=\"1-2-1-2-2\">\n                    <img alt=\"Kids learning adventure crew flying through the clouds\" data-kid=\"1-2-1-2-2-1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/hero-bg.jpg\"/>\n                    <span aria-hidden=\"true\" class=\"comet\" data-kid=\"1-2-1-2-2-2\">\n                    </span>\n                </div>\n            </section>\n            <section aria-label=\"Catalogue snapshot\" class=\"metric-band\" data-kid=\"1-2-1-3\">\n                <article class=\"metric motion-metric\" data-kid=\"1-2-1-3-1\">\n                    <div class=\"metric-label\" data-kid=\"1-2-1-3-1-1\">\n                        <i aria-hidden=\"true\" data-kid=\"1-2-1-3-1-1-1\" data-lucide=\"film\">\n                        </i>\n                        Shows\n                    </div>\n                    <div class=\"metric-value\" data-kid=\"1-2-1-3-1-2\">\n                        2\n                    </div>\n                    <div class=\"metric-note\" data-kid=\"1-2-1-3-1-3\">\n                        in catalogue\n                    </div>\n                </article>\n                <article class=\"metric motion-metric\" data-kid=\"1-2-1-3-2\">\n                    <div class=\"metric-label\" data-kid=\"1-2-1-3-2-1\">\n                        <i aria-hidden=\"true\" data-kid=\"1-2-1-3-2-1-1\" data-lucide=\"check-circle-2\">\n                        </i>\n                        Published\n                    </div>\n                    <div class=\"metric-value\" data-kid=\"1-2-1-3-2-2\">\n                        1\n                    </div>\n                    <div class=\"metric-note\" data-kid=\"1-2-1-3-2-3\">\n                        visible in viewer\n                    </div>\n                </article>\n                <article class=\"metric motion-metric\" data-kid=\"1-2-1-3-3\">\n                    <div class=\"metric-label\" data-kid=\"1-2-1-3-3-1\">\n                        <i aria-hidden=\"true\" data-kid=\"1-2-1-3-3-1-1\" data-lucide=\"file-pen-line\">\n                        </i>\n                        Drafts\n                    </div>\n                    <div class=\"metric-value\" data-kid=\"1-2-1-3-3-2\">\n                        1\n                    </div>\n                    <div class=\"metric-note\" data-kid=\"1-2-1-3-3-3\">\n                        still in progress\n                    </div>\n                </article>\n                <article class=\"metric motion-metric\" data-kid=\"1-2-1-3-4\">\n                    <div class=\"metric-label\" data-kid=\"1-2-1-3-4-1\">\n                        <i aria-hidden=\"true\" data-kid=\"1-2-1-3-4-1-1\" data-lucide=\"clapperboard\">\n                        </i>\n                        Episodes\n                    </div>\n                    <div class=\"metric-value\" data-kid=\"1-2-1-3-4-2\">\n                        16\n                    </div>\n                    <div class=\"metric-note\" data-kid=\"1-2-1-3-4-3\">\n                        across all seasons\n                    </div>\n                </article>\n                <article class=\"metric metric-danger motion-metric\" data-kid=\"1-2-1-3-5\">\n                    <div class=\"metric-label\" data-kid=\"1-2-1-3-5-1\">\n                        <i aria-hidden=\"true\" data-kid=\"1-2-1-3-5-1-1\" data-lucide=\"triangle-alert\">\n                        </i>\n                        Blockers\n                    </div>\n                    <div class=\"metric-value\" data-kid=\"1-2-1-3-5-2\">\n                        2\n                    </div>\n                    <div class=\"metric-note\" data-kid=\"1-2-1-3-5-3\">\n                        need attention today\n                    </div>\n                </article>\n            </section>\n            <section class=\"core-grid\" data-kid=\"1-2-1-4\">\n                <article class=\"panel queue-panel motion-panel\" data-kid=\"1-2-1-4-1\" id=\"needs-eyes\">\n                    <div class=\"queue-intro\" data-kid=\"1-2-1-4-1-1\">\n                        <div data-kid=\"1-2-1-4-1-1-1\">\n                            <h2 data-kid=\"1-2-1-4-1-1-1-1\" data-name=\"panel title text\">\n                                Needs your eyes\n                            </h2>\n                            <p data-kid=\"1-2-1-4-1-1-1-2\">\n                                Small fixes with a clear next step.\n                            </p>\n                        </div>\n                        <span class=\"queue-count\" data-kid=\"1-2-1-4-1-1-2\">\n                            <i aria-hidden=\"true\" data-kid=\"1-2-1-4-1-1-2-1\" data-lucide=\"circle-alert\">\n                            </i>\n                            2 blockers\n                        </span>\n                    </div>\n                    <div class=\"motion-row\" data-kid=\"1-2-1-4-1-2\" data-row=\"thumbnail\">\n                        <button aria-expanded=\"false\" class=\"row-trigger\" data-kid=\"1-2-1-4-1-2-1\" type=\"button\">\n                            <span class=\"issue-icon danger\" data-kid=\"1-2-1-4-1-2-1-1\">\n                                <i aria-hidden=\"true\" data-kid=\"1-2-1-4-1-2-1-1-1\" data-lucide=\"image-off\">\n                                </i>\n                            </span>\n                            <span class=\"row-copy\" data-kid=\"1-2-1-4-1-2-1-2\">\n                                <span class=\"row-title\" data-kid=\"1-2-1-4-1-2-1-2-1\">\n                                    The Moon Maze\n                                    <span class=\"row-state danger\" data-kid=\"1-2-1-4-1-2-1-2-1-1\">\n                                        Missing artwork\n                                    </span>\n                                </span>\n                                <span class=\"row-meta\" data-kid=\"1-2-1-4-1-2-1-2-2\">\n                                    Episode · Astro & Friends · Season 1\n                                </span>\n                            </span>\n                            <i aria-hidden=\"true\" class=\"row-chevron\" data-kid=\"1-2-1-4-1-2-1-3\" data-lucide=\"chevron-down\">\n                            </i>\n                        </button>\n                        <div class=\"row-detail\" data-kid=\"1-2-1-4-1-2-2\">\n                            <div class=\"row-detail-inner\" data-kid=\"1-2-1-4-1-2-2-1\">\n                                <p data-kid=\"1-2-1-4-1-2-2-1-1\">\n                                    Add a 16:9 thumbnail so this episode can pass the catalogue check.\n                                </p>\n                                <a class=\"row-action\" data-kid=\"1-2-1-4-1-2-2-1-2\" href=\"#episode-artwork\">\n                                    Open artwork\n                                    <i aria-hidden=\"true\" data-kid=\"1-2-1-4-1-2-2-1-2-1\" data-lucide=\"arrow-up-right\">\n                                    </i>\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"motion-row\" data-kid=\"1-2-1-4-1-3\" data-row=\"section\">\n                        <button aria-expanded=\"false\" class=\"row-trigger\" data-kid=\"1-2-1-4-1-3-1\" type=\"button\">\n                            <span class=\"issue-icon warning\" data-kid=\"1-2-1-4-1-3-1-1\">\n                                <i aria-hidden=\"true\" data-kid=\"1-2-1-4-1-3-1-1-1\" data-lucide=\"tag\">\n                                </i>\n                            </span>\n                            <span class=\"row-copy\" data-kid=\"1-2-1-4-1-3-1-2\">\n                                <span class=\"row-title\" data-kid=\"1-2-1-4-1-3-1-2-1\">\n                                    Curious Comet Club\n                                    <span class=\"row-state warning\" data-kid=\"1-2-1-4-1-3-1-2-1-1\">\n                                        Needs section\n                                    </span>\n                                </span>\n                                <span class=\"row-meta\" data-kid=\"1-2-1-4-1-3-1-2-2\">\n                                    Show metadata · Draft\n                                </span>\n                            </span>\n                            <i aria-hidden=\"true\" class=\"row-chevron\" data-kid=\"1-2-1-4-1-3-1-3\" data-lucide=\"chevron-down\">\n                            </i>\n                        </button>\n                        <div class=\"row-detail\" data-kid=\"1-2-1-4-1-3-2\">\n                            <div class=\"row-detail-inner\" data-kid=\"1-2-1-4-1-3-2-1\">\n                                <p data-kid=\"1-2-1-4-1-3-2-1-1\">\n                                    Choose a catalogue section before moving this show from draft to published.\n                                </p>\n                                <a class=\"row-action\" data-kid=\"1-2-1-4-1-3-2-1-2\" href=\"#show-metadata\">\n                                    Edit metadata\n                                    <i aria-hidden=\"true\" data-kid=\"1-2-1-4-1-3-2-1-2-1\" data-lucide=\"arrow-up-right\">\n                                    </i>\n                                </a>\n                            </div>\n                        </div>\n                    </div>\n                </article>\n                <div class=\"side-stack\" data-kid=\"1-2-1-4-2\">\n                    <article class=\"panel readiness motion-panel\" data-kid=\"1-2-1-4-2-1\" id=\"readiness-panel\">\n                        <div class=\"panel-header\" data-kid=\"1-2-1-4-2-1-1\">\n                            <div data-kid=\"1-2-1-4-2-1-1-1\">\n                                <h2 data-kid=\"1-2-1-4-2-1-1-1-1\">\n                                    Publishing readiness\n                                </h2>\n                                <p data-kid=\"1-2-1-4-2-1-1-1-2\">\n                                    Checks are grouped by what needs to happen next.\n                                </p>\n                            </div>\n                            <span class=\"readiness-status\" data-kid=\"1-2-1-4-2-1-1-2\">\n                                <span class=\"dot\" data-kid=\"1-2-1-4-2-1-1-2-1\">\n                                </span>\n                                Blocked\n                            </span>\n                        </div>\n                        <div class=\"readiness-body\" data-kid=\"1-2-1-4-2-1-2\">\n                            <p class=\"readiness-lead\" data-kid=\"1-2-1-4-2-1-2-1\">\n                                6 of 8 checks passed.\n                            </p>\n                            <p class=\"readiness-copy\" data-kid=\"1-2-1-4-2-1-2-2\">\n                                Resolve the two items in your queue, then review the report before publishing.\n                            </p>\n                            <div class=\"progress-wrap\" data-kid=\"1-2-1-4-2-1-2-3\">\n                                <div class=\"progress-label\" data-kid=\"1-2-1-4-2-1-2-3-1\">\n                                    <span data-kid=\"1-2-1-4-2-1-2-3-1-1\">\n                                        Catalogue checks\n                                    </span>\n                                    <span data-kid=\"1-2-1-4-2-1-2-3-1-2\">\n                                        75%\n                                    </span>\n                                </div>\n                                <div class=\"progress-track\" data-kid=\"1-2-1-4-2-1-2-3-2\">\n                                    <div class=\"progress-bar\" data-kid=\"1-2-1-4-2-1-2-3-2-1\">\n                                    </div>\n                                </div>\n                            </div>\n                            <a class=\"button button-primary\" data-kid=\"1-2-1-4-2-1-2-4\" href=\"#publish\">\n                                <i aria-hidden=\"true\" data-kid=\"1-2-1-4-2-1-2-4-1\" data-lucide=\"clipboard-check\">\n                                </i>\n                                Open validation report\n                            </a>\n                        </div>\n                    </article>\n                    <article class=\"panel release motion-panel\" data-kid=\"1-2-1-4-2-2\">\n                        <div class=\"release-kicker\" data-kid=\"1-2-1-4-2-2-1\">\n                            <span data-kid=\"1-2-1-4-2-2-1-1\">\n                                Last release\n                            </span>\n                            <span class=\"release-status\" data-kid=\"1-2-1-4-2-2-1-2\">\n                                ● Success\n                            </span>\n                        </div>\n                        <p class=\"release-title\" data-kid=\"1-2-1-4-2-2-2\">\n                            3 September · 3:30 PM\n                        </p>\n                        <div class=\"release-meta\" data-kid=\"1-2-1-4-2-2-3\">\n                            <div class=\"release-stat\" data-kid=\"1-2-1-4-2-2-3-1\">\n                                <span data-kid=\"1-2-1-4-2-2-3-1-1\">\n                                    Shows\n                                </span>\n                                <strong data-kid=\"1-2-1-4-2-2-3-1-2\">\n                                    8\n                                </strong>\n                            </div>\n                            <div class=\"release-stat\" data-kid=\"1-2-1-4-2-2-3-2\">\n                                <span data-kid=\"1-2-1-4-2-2-3-2-1\">\n                                    Episodes\n                                </span>\n                                <strong data-kid=\"1-2-1-4-2-2-3-2-2\">\n                                    46\n                                </strong>\n                            </div>\n                            <div class=\"release-stat\" data-kid=\"1-2-1-4-2-2-3-3\">\n                                <span data-kid=\"1-2-1-4-2-2-3-3-1\">\n                                    Size\n                                </span>\n                                <strong data-kid=\"1-2-1-4-2-2-3-3-2\">\n                                    178 KB\n                                </strong>\n                            </div>\n                        </div>\n                        <a class=\"release-link\" data-kid=\"1-2-1-4-2-2-4\" href=\"#history\">\n                            View release history\n                            <i aria-hidden=\"true\" data-kid=\"1-2-1-4-2-2-4-1\" data-lucide=\"arrow-right\">\n                            </i>\n                        </a>\n                    </article>\n                </div>\n            </section>\n            <p aria-live=\"polite\" class=\"screen-reader-note\" data-dynamic=\"true\" data-kid=\"1-2-1-5\" data-name=\"screen reader polite notification area\" data-reason=\"text content updated by script to provide feedback\" id=\"interactionNote\">\n            </p>\n        </div>\n    </main>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    document.addEventListener('DOMContentLoaded', function () {\n    if (window.lucide) window.lucide.createIcons();\n\n    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n    var motionTargets = '.motion-page, .motion-media, .motion-heading, .motion-metric, .motion-panel, .motion-row';\n\n    if (reduceMotion) {\n      gsap.set(motionTargets, { autoAlpha: 1, y: 0, x: 0, scale: 1, clearProps: 'transform,opacity,visibility' });\n    } else {\n      var intro = gsap.timeline({ defaults: { ease: 'power2.out' } });\n      intro.from('.motion-page', { autoAlpha: 0, y: 12, duration: .32 })\n        .from('.motion-media', { autoAlpha: 0, y: 14, duration: .38 }, '-=.16')\n        .from('.motion-heading', { autoAlpha: 0, y: 10, duration: .28 }, '-=.18')\n        .from('.motion-metric', { autoAlpha: 0, y: 10, duration: .28, stagger: .05 }, '-=.12')\n        .from('.motion-panel', { autoAlpha: 0, y: 14, duration: .34, stagger: .08 }, '-=.12')\n        .from('.motion-row', { autoAlpha: 0, y: 9, duration: .25, stagger: .07 }, '-=.16');\n      intro.fromTo('.comet', { autoAlpha: 0, x: -16, y: 9, scale: .7 }, { autoAlpha: 1, x: 180, y: -12, scale: 1, duration: .55, ease: 'power2.out' }, .18)\n        .to('.comet', { autoAlpha: 0, duration: .16 }, '>.02');\n    }\n\n    document.querySelectorAll('button, a').forEach(function (element) {\n      var hover = gsap.to(element, { y: -2, scale: 1.02, duration: .18, ease: 'power2.out', paused: true, overwrite: 'auto' });\n      element.addEventListener('pointerenter', function () { if (!reduceMotion) hover.play(); });\n      element.addEventListener('pointerleave', function () { if (!reduceMotion) hover.reverse(); });\n    });\n\n    var review = document.getElementById('reviewBlockers');\n    var readiness = document.getElementById('readiness-panel');\n    review.addEventListener('click', function () {\n      readiness.classList.add('focus-ring');\n      readiness.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });\n      if (!reduceMotion) gsap.fromTo(readiness, { boxShadow: '0 0 0 rgba(200,83,83,0)' }, { boxShadow: '0 0 0 5px rgba(200,83,83,.15)', duration: .28, yoyo: true, repeat: 1, ease: 'power2.out' });\n      setTimeout(function () { readiness.classList.remove('focus-ring'); }, 1500);\n    });\n\n    var refresh = document.getElementById('refreshReport');\n    var refreshIcon = refresh.querySelector('.refresh-icon');\n    var refreshLabel = refresh.querySelector('.refresh-label');\n    refresh.addEventListener('click', function () {\n      var previous = refreshLabel.textContent;\n      refreshLabel.textContent = 'Report refreshed';\n      if (!reduceMotion) gsap.to(refreshIcon, { rotation: 360, duration: .55, ease: 'power2.out' });\n      setTimeout(function () { refreshLabel.textContent = previous; if (!reduceMotion) gsap.set(refreshIcon, { rotation: 0 }); }, 1600);\n    });\n\n    document.querySelectorAll('.motion-row').forEach(function (row) {\n      var trigger = row.querySelector('.row-trigger');\n      var detail = row.querySelector('.row-detail');\n      var chevron = row.querySelector('.row-chevron');\n      var open = false;\n      trigger.addEventListener('click', function () {\n        open = !open;\n        trigger.setAttribute('aria-expanded', String(open));\n        if (open) {\n          detail.style.height = 'auto';\n          var height = detail.offsetHeight;\n          detail.style.height = '0px';\n          if (reduceMotion) { detail.style.height = 'auto'; detail.style.opacity = '1'; }\n          else gsap.to(detail, { height: height, autoAlpha: 1, duration: .28, ease: 'power2.out', overwrite: 'auto', onComplete: function () { detail.style.height = 'auto'; } });\n          if (!reduceMotion) gsap.to(chevron, { rotation: 180, duration: .22, ease: 'power2.out', overwrite: 'auto' });\n        } else {\n          if (reduceMotion) { detail.style.height = '0px'; detail.style.opacity = '0'; }\n          else gsap.to(detail, { height: 0, autoAlpha: 0, duration: .22, ease: 'power2.out', overwrite: 'auto' });\n          if (!reduceMotion) gsap.to(chevron, { rotation: 0, duration: .18, ease: 'power2.out', overwrite: 'auto' });\n        }\n      });\n    });\n  });\n</script>\n",
